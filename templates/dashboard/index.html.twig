{% extends 'base.html.twig' %}

{% block title %}Panel Główny - Pulse Kinetic{% endblock %}

{% block body %}
<div class="container mt-5">
    
    <!-- Powitanie i Szybkie Statystyki -->
    <div class="row mb-4">
        <div class="col-md-8">
            <h2 class="text-light fw-bold">Cześć, <span class="text-success">{{ app.user.name }}</span>! ⚡</h2>
            <p class="text-muted fs-5">Gotowy na dzisiejsze wyzwanie?</p>
        </div>
        <div class="col-md-4 text-md-end">
            <div class="badge bg-dark border border-secondary p-3 text-start w-100 shadow-sm">
                <div class="text-warning small text-uppercase fw-bold mb-1">Twój Cel</div>
                <div class="fs-6 text-light">{{ app.user.currentGoal ? app.user.currentGoal.name : 'Brak wybranego celu' }}</div>
                <hr class="border-secondary my-2">
                <div class="d-flex justify-content-between">
                    <span class="text-muted small">Waga: <strong class="text-light">{{ app.user.weight }} kg</strong></span>
                    <a href="{{ path('app_profile') }}" class="text-success small text-decoration-none"><i class="bi bi-pencil-square"></i> Edytuj</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Sekcja Aktywnego Planu Treningowego -->
    <div class="row">
        <div class="col-12">
            <div class="card bg-dark text-light border-secondary shadow p-4">
                
                {% if plan %}
                    <div class="d-flex justify-content-between align-items-start mb-4">
                        <div>
                            <h4 class="text-warning fw-bold mb-1"><i class="bi bi-card-checklist"></i> Aktywny Plan</h4>
                            <h5 class="text-light m-0">{{ plan.name }}</h5>
                        </div>
                        <span class="badge bg-success fs-6"><i class="bi bi-activity"></i> W toku</span>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-sm-4">
                            <div class="p-3 border border-secondary rounded bg-opacity-10 bg-light text-center">
                                <h2 class="fw-bold text-light m-0">{{ plan.workoutExercises|length }}</h2>
                                <span class="text-muted small text-uppercase">Wszystkich ćwiczeń</span>
                            </div>
                        </div>
                        <div class="col-sm-8 d-flex align-items-center">
                            <p class="text-muted m-0">
                                Twój plan jest gotowy i czeka na realizację. System "Pulse Kinetic" precyzyjnie dobrał dla Ciebie obciążenia i zakresy powtórzeń na podstawie Twojego celu.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <a href="{{ path('app_generator_success', {'id': plan.id}) }}" class="btn btn-outline-light btn-lg">
                            <i class="bi bi-eye"></i> Podgląd Planu
                        </a>
                        <button class="btn btn-primary btn-lg fw-bold flex-grow-1 disabled">
                            Rozpocznij Trening <i class="bi bi-play-fill"></i> (Wkrótce)
                        </button>
                    </div>

                {% else %}
                    <!-- Stan pusty (Brak planu) -->
                    <div class="text-center py-5">
                        <i class="bi bi-clipboard-x text-muted" style="font-size: 4rem;"></i>
                        <h4 class="mt-3 fw-bold">Brak aktywnego planu</h4>
                        <p class="text-muted mb-4">Twój kalendarz treningowy jest pusty. Zbudujmy idealny plan oparty na prawach biomechaniki.</p>
                        <a href="{{ path('app_generator_start') }}" class="btn btn-success btn-lg fw-bold px-5">
                            <i class="bi bi-magic"></i> Inteligentny Generator Planu
                        </a>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
</div>
{% endblock %}