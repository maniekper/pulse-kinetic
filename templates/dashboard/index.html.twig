{% extends 'app_layout.html.twig' %}

{% block title %}Dashboard | PULSE KINETIC{% endblock %}

{% block app_content %}
    <main class="kinetic-bg-container">
        
        <div class="kinetic-bg-gradient"></div>

        <header class="kinetic-main-header">
            <div class="kinetic-main-header-stripe"></div>
            <div>
                <h1 class="kinetic-main-header-title">DASHBOARD <span class="text-primary-container">GŁÓWNY</span></h1>
                <p class="kinetic-main-header-subtitle">CENTRUM DOWODZENIA I ANALITYKI</p>
            </div>
            <div class="hidden md:block">
                <span class="badge bg-[#1a1a1a] px-4 py-2 border border-white/10 font-headline font-bold text-xs tracking-widest text-[#767575]">{{ app.user.email }}</span>
            </div>
        </header>

        <div class="relative z-10">
            
            <!-- POTĘŻNY PASEK POSTĘPU MEZOCYKLU -->
            <div class="flex flex-col gap-4 font-label uppercase mb-12 border-b border-white/5 pb-10">
                <div class="flex items-center gap-2 text-[10px] text-outline tracking-[0.2em]">
                    <span class="text-[#767575]">FOCUS:</span> 
                    <strong class="text-white">{{ plan ? plan.name : 'BRAK PLANU' }}</strong> 
                    <span class="text-[#767575]">&bull; SESSION {{ nextDayNumber }}</span>
                </div>
                
                {% if plan and totalSessionsInCycle > 0 %}
                <div class="w-full max-w-2xl flex flex-col gap-3 mt-4">
                    <div class="flex justify-between items-end mb-1">
                        <span class="font-headline text-xs md:text-sm text-[#767575] font-black tracking-widest uppercase">PROGRES MEZOCYKLU</span>
                        <div class="font-headline text-3xl md:text-4xl text-primary-container font-black tracking-tighter leading-none">
                            {{ completedSessionsCount }} <span class="text-sm md:text-lg text-[#767575] tracking-widest font-bold">/ {{ totalSessionsInCycle }} SESJI</span>
                        </div>
                    </div>
                    <div class="h-3 md:h-4 bg-[#111111] border border-white/10 w-full relative overflow-hidden shadow-inner">
                        {% set cycleProgress = (completedSessionsCount / totalSessionsInCycle) * 100 %}
                        <div class="h-full bg-primary-container absolute top-0 left-0 transition-all duration-1000 ease-out" style="width: {{ cycleProgress }}%; box-shadow: 0 0 20px var(--theme-main);"></div>
                    </div>
                </div>
                {% endif %}
            </div>
            <!-- KONIEC PASKA -->

            <div class="grid grid-cols-1 xl:grid-cols-12 gap-10">
                
                <!-- LEWA KOLUMNA: Plan na dziś -->
                <div class="xl:col-span-7 flex flex-col gap-6">
                    
                    <div class="kinetic-section-title-wrap">
                        <h2 class="kinetic-section-title">ZAPLANOWANY BLOK NA DZIŚ</h2>
                        <span class="font-headline font-bold text-[10px] text-primary-container tracking-widest ml-auto">0% COMPLETE</span>
                    </div>

                    {% if plan %}
                        <div class="flex flex-col gap-2">
{% set todaysExercises = plan.workoutExercises|filter(e => e.dayNumber == nextDayNumber) %}                            
                            {% for exercise in todaysExercises %}
                                {% include 'components/_exercise_row.html.twig' with {
                                    'exercise': exercise,
                                    'index': loop.index,
                                    'show_status': true
                                } %}
                            {% else %}
                                <div class="text-[#767575] text-sm py-4 uppercase tracking-widest font-bold font-headline">Brak przypisanych ćwiczeń dla tej sesji.</div>
                            {% endfor %}
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
                            <div class="kinetic-panel relative">
                                <span class="material-symbols-outlined absolute top-6 right-6 text-primary-container">schedule</span>
                                <div class="font-label text-[10px] text-[#767575] uppercase tracking-widest mb-2">SZACOWANY CZAS TRENINGU</div>
                                <div class="font-headline font-black text-3xl text-white tracking-tighter leading-none">{{ estimatedTimeMinutes > 0 ? estimatedTimeMinutes : '--' }} MINUT</div>
                                <div class="font-label text-[9px] text-[#767575] uppercase mt-2 tracking-widest">ZAWIERA 10 MIN ROZGRZEWKI</div>
                            </div>
                        </div>

                    {% else %}
                        <div class="kinetic-panel border-[#ff7351]/30 text-center flex flex-col items-center !p-12">
                            <span class="material-symbols-outlined text-[#ff7351] text-5xl mb-4 animate-pulse">warning</span>
                            <span class="font-headline text-white font-bold uppercase tracking-widest mb-2">Brak aktywnego protokołu</span>
                            <span class="font-body text-[#767575] text-sm uppercase tracking-wider">Wygeneruj plan, aby odblokować moduł analityczny.</span>
                        </div>
                    {% endif %}

                </div>

                <!-- PRAWA KOLUMNA: Osiągi -->
                <div class="xl:col-span-5 flex flex-col gap-6">
                    
                    <div class="kinetic-section-title-wrap">
                        <h2 class="kinetic-section-title">OSIĄGI OGÓLNE</h2>
                    </div>

                    <div class="kinetic-panel relative flex flex-col justify-center min-h-[160px]">
                        <div class="flex items-baseline gap-2">
                            <span class="font-headline font-black text-6xl text-primary-container tracking-tighter leading-none">{{ (totalTonnage / 1000)|number_format(1, '.', '') }}</span>
                            <span class="font-headline font-bold text-lg text-[#767575] uppercase">TON</span>
                        </div>
                        <div class="flex items-center gap-2 mt-4 text-primary-container font-headline font-bold text-[10px] uppercase tracking-widest">
                            <span class="material-symbols-outlined text-sm">trending_up</span>
                            Wydajność operacyjna w normie
                        </div>
                    </div>

                    <div class="kinetic-panel !p-6">
                        <div class="flex items-end justify-between h-20 gap-2 mb-2">
                            {% for data in chartData %}
                                {% set heightPercentage = (data.tonnage / (maxChartValue > 0 ? maxChartValue : 1)) * 100 %}
                                <div class="w-full {% if data.tonnage > 0 %}bg-primary-container shadow-[0_0_15px_var(--theme-shadow)]{% else %}bg-white/5{% endif %} rounded-t-[1px] transition-all duration-1000" 
                                     style="height: {{ heightPercentage > 5 ? heightPercentage : 5 }}%;"
                                     title="{{ data.tonnage }} KG">
                                </div>
                            {% endfor %}
                        </div>
                        <div class="flex justify-between font-headline font-bold text-[9px] text-[#767575] uppercase tracking-widest">
                            {% for data in chartData %}
                                <span>{{ data.day }}</span>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="kinetic-panel flex flex-col gap-4 !p-6">
                        {% for lift in maxLifts %}
                            <div class="flex justify-between items-end {% if not loop.last %}border-b border-white/5 pb-3{% endif %} hover:bg-white/5 transition-colors p-2 -mx-2 rounded-sm">
                                <div class="flex flex-col">
                                    <span class="font-label text-[10px] text-[#767575] uppercase tracking-widest">{{ lift.machineName }}</span>
                                    <span class="font-headline font-black text-lg text-white">{{ lift.maxWeight }} KG</span>
                                </div>
                                {% if loop.last %}
                                    <span class="font-label text-[9px] text-primary-container uppercase tracking-widest font-black">ALL TIME HIGH</span>
                                {% endif %}
                            </div>
                        {% else %}
                            <span class="text-[#767575] text-xs font-bold uppercase tracking-widest font-headline block">Brak zarejestrowanych rekordów.</span>
                        {% endfor %}
                    </div>

                </div>
            </div>
        </div>
    </main>
    <!-- MODAL ZMIANY MASZYNY DLA DASHBOARDU -->
    <div id="swapModal" class="fixed inset-0 bg-black/90 backdrop-blur-sm z-[999] hidden items-center justify-center p-4">
        <div class="bg-[#111111] border border-primary-container shadow-[0_0_40px_var(--theme-shadow)] w-full max-w-lg flex flex-col relative">
            <div class="p-6 border-b border-white/5 bg-[#1a1a1a] flex justify-between items-center">
                <h3 class="font-headline font-black text-lg text-white uppercase tracking-widest">Wymiana Sprzętu</h3>
                <button type="button" onclick="closeSwapModal()" class="text-[#767575] hover:text-white transition-colors cursor-pointer">
                    <span class="material-symbols-outlined text-2xl">close</span>
                </button>
            </div>
            
            <form id="swapForm" method="POST" action="" class="p-6 flex flex-col gap-6">
                <div>
                    <div class="font-label text-[10px] text-[#767575] uppercase tracking-widest mb-2">OBECNY SPRZĘT (TRAFI NA CZARNĄ LISTĘ):</div>
                    <div id="currentMachineName" class="font-headline font-bold text-sm text-[#ff4444] uppercase tracking-widest bg-[#ff4444]/10 border border-[#ff4444]/20 p-3 line-through"></div>
                </div>
                
                <div>
                    <div class="font-label text-[10px] text-[#767575] uppercase tracking-widest mb-3">WYBIERZ ZASTĘPSTWO (Z TEJ SAMEJ PARTII):</div>
                    
                    <!-- Ukryty input przechowujący ID wybranej maszyny -->
                    <input type="hidden" name="new_machine_id" id="selectedMachineId" required>

                    <!-- Siatka alternatywnych maszyn z miniaturkami -->
                    <div id="machineGrid" class="grid grid-cols-2 gap-3 max-h-64 overflow-y-auto pr-1 hide-scrollbar">
                        <!-- Dynamicznie generowane przez JS -->
                    </div>
                </div>

                <button type="submit" id="swapSubmitBtn" class="w-full bg-primary-container hover:bg-primary-dim py-4 flex items-center justify-center gap-3 transition-colors mt-2 cursor-pointer opacity-30 pointer-events-none">
                    <span class="material-symbols-outlined text-on-primary-container">published_with_changes</span>
                    <span class="font-headline font-black text-xs text-on-primary-container uppercase tracking-widest">POTWIERDŹ ZMIANĘ</span>
                </button>
            </form>
        </div>
    </div>

    <!-- SKRYPT MODALA -->
    <script>
        const machinesData = [
            {% for m in allMachines %}
                {
                    id: {{ m.id }},
                    name: "{{ m.name|escape('js') }}",
                    image: "{{ m.imageStart ? asset('images/machines/' ~ m.imageStart) : '' }}",
                    muscles: [
                        {% for mus in m.primaryMuscles %}
                            "{{ mus.name|escape('js') }}"{% if not loop.last %},{% endif %}
                        {% endfor %}
                    ]
                }{% if not loop.last %},{% endif %}
            {% endfor %}
        ];

        let currentExerciseId = null;

        function openSwapModal(exerciseId, machineName, muscleName) {
            currentExerciseId = exerciseId;
            const modal = document.getElementById('swapModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            
            document.getElementById('currentMachineName').innerText = machineName;
            document.getElementById('selectedMachineId').value = '';
            
            const grid = document.getElementById('machineGrid');
            const submitBtn = document.getElementById('swapSubmitBtn');
            grid.innerHTML = '';
            
            // Wyłączamy przycisk do momentu wyboru
            submitBtn.classList.add('opacity-30', 'pointer-events-none');
            
            const compatibleMachines = machinesData.filter(m => 
                m.muscles.includes(muscleName) && m.name !== machineName
            );
            
            if (compatibleMachines.length === 0) {
                grid.innerHTML = '<div class="col-span-2 text-[#767575] text-xs py-4 uppercase tracking-widest font-headline text-center">Brak alternatyw dla tej partii w bazie.</div>';
            } else {
                compatibleMachines.forEach(m => {
                    const card = document.createElement('div');
                    card.className = "bg-[#161616] border border-white/10 p-3 flex flex-col gap-3 cursor-pointer hover:border-primary-container transition-all group select-none relative";
                    card.setAttribute('data-id', m.id);
                    
                   const imgHtml = m.image 
                        ? `<img src="${m.image}" class="w-full h-24 object-contain p-1 mix-blend-luminosity opacity-80 group-hover:opacity-100 transition-opacity">`
                        : `<div class="w-full h-24 bg-[#1a1a1a] flex items-center justify-center text-outline"><span class="material-symbols-outlined">fitness_center</span></div>`;`<div class="w-full h-24 bg-[#1a1a1a] flex items-center justify-center text-outline"><span class="material-symbols-outlined">fitness_center</span></div>`;

                    card.innerHTML = `
                        <div class="w-full overflow-hidden bg-[#1a1a1a] border border-white/5 relative">
                            ${imgHtml}
                        </div>
                        <span class="font-headline font-bold text-xs text-white uppercase tracking-tight text-center line-clamp-2">${m.name}</span>
                    `;
                    
                    card.onclick = () => selectMachineCard(card, m.id);
                    grid.appendChild(card);
                });
            }
        }

        function selectMachineCard(cardElement, machineId) {
            // Usuń zaznaczenie z innych
            document.querySelectorAll('#machineGrid > div').forEach(c => {
                c.classList.remove('border-primary-container', 'bg-primary-container/10');
                c.classList.add('border-white/10', 'bg-[#161616]');
            });
            
            // Zaznacz kliknięty kafelek
            cardElement.classList.remove('border-white/10', 'bg-[#161616]');
            cardElement.classList.add('border-primary-container', 'bg-primary-container/10');
            
            // Ustaw ID i aktywuj formularz
            document.getElementById('selectedMachineId').value = machineId;
            const form = document.getElementById('swapForm');
            form.action = '/tracker/swap/' + currentExerciseId + '/' + machineId;
            
            const submitBtn = document.getElementById('swapSubmitBtn');
            submitBtn.classList.remove('opacity-30', 'pointer-events-none');
        }

        function closeSwapModal() {
            const modal = document.getElementById('swapModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function updateFormAction() {
            const select = document.getElementById('newMachineSelect');
            const form = document.getElementById('swapForm');
            if (select.value && currentExerciseId) {
                form.action = '/tracker/swap/' + currentExerciseId + '/' + select.value;
            }
        }
    </script>
{% endblock %}