{% extends 'base.html.twig' %}

{% block title %}Panel Treningowy - Pulse Kinetic{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #121212; color: #f8f9fa; }
        .card { background-color: #1e1e1e; border: 1px solid #333; border-radius: 12px; }
        .text-pulse { color: #0d6efd; }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-5">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success fw-bold text-center border-success mb-4" role="alert">
            {{ message }}
        </div>
    {% endfor %}
    <div class="row mb-4">
        <div class="col">
            <h1 class="fw-bold">Witaj, <span class="text-pulse">{{ user.userIdentifier }}</span>!</h1>
            <p class="text-muted">Twój bezpieczny panel treningowy Pulse Kinetic.</p>
        </div>
    </div>

    <div class="row">
        <!-- Kafel z celem -->
        <div class="col-md-6 mb-3">
            <div class="card p-4 h-100 shadow-sm">
                <h4 class="text-muted mb-3">Aktualny Cel</h4>
                <h2 class="text-success fw-bold">{{ currentGoal ? currentGoal.name : 'Brak aktywnego celu' }}</h2>
            </div>
        </div>
        
        <!-- Kafel z wagą -->
        <div class="col-md-6 mb-3">
            <div class="card p-4 h-100 shadow-sm">
                <h4 class="text-muted mb-3">Twoja Waga</h4>
                <h2 class="text-warning fw-bold">
                    {{ user.currentWeight ? user.currentWeight ~ ' kg' : 'Brak danych' }}
                </h2>
            </div>
        </div>
    </div>
    
    <!-- NOWA SEKCJA: Rekordy -->
    <div class="row mt-5 mb-4">
        <div class="col-12">
            <h3 class="fw-bold mb-4 text-warning">🏆 Twoje Życiówki (PR)</h3>
        </div>
        
        {% if records is empty %}
            <div class="col-12">
                <div class="alert alert-dark border-warning text-warning text-center" role="alert">
                    Brak rekordów. Zrób pierwszy trening, aby ustanowić życiówki!
                </div>
            </div>
        {% else %}
            {% for record in records %}
                <div class="col-6 col-md-3 mb-3">
                    <div class="card p-3 h-100 shadow-sm border-warning">
                        <small class="text-muted fw-bold mb-1">{{ record.machine.name }}</small>
                        <span class="fs-4 text-light fw-bold">{{ record.maxWeight }} kg</span>
                        <span class="text-muted small">x {{ record.maxRepsAtMaxWeight }} powt.</span>
                        <small class="text-secondary mt-2" style="font-size: 0.7rem;">{{ record.achievedAt|date('d.m.Y') }}</small>
                    </div>
                </div>
            {% endfor %}
        {% endif %}
    </div>

    <div class="mt-5 mb-5 border-top border-secondary pt-4">
        <a href="{{ path('app_logout') }}" class="btn btn-outline-danger">Wyloguj się</a>
    </div>
</div>
{% endblock %}
