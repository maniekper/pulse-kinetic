{% extends 'base.html.twig' %}

{% block title %}Kreator Planu - Krok 2{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-4 shadow-sm border-secondary bg-dark text-light">
                <h3 class="fw-bold mb-3 text-success">🤖 Inteligentny Trener</h3>
                <p class="text-muted mb-4">Krok 2: Wybierz partie mięśniowe, na których chcesz się skupić:</p>

                <form action="{{ path('app_generator_save_muscles') }}" method="POST">
                    <div class="mb-4">
                        {% for group in muscleGroups %}
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="muscles[]" value="{{ group.id }}" id="muscle{{ group.id }}">
                                <label class="form-check-label fw-bold" for="muscle{{ group.id }}">
                                    {{ group.name }}
                                </label>
                            </div>
                        {% endfor %}
                    </div>
                    
                    <button type="submit" class="btn btn-primary w-100 fw-bold btn-lg">Dalej <i class="bi bi-arrow-right"></i></button>
                </form>
            </div>
        </div>
    </div>
</div>
{% endblock %}