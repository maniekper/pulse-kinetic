{% extends 'base.html.twig' %}
{% block title %}Krok 3 - Wykluczenia{% endblock %}
{% block body %}
<div class="container mt-5">
    <div class="card bg-dark text-light border-secondary p-4 shadow">
        <h3 class="text-success fw-bold">Krok 3: Kontuzje (Opcjonalnie)</h3>
        <p class="text-muted mb-4">Domyślnie planujemy trening <strong>CAŁEGO CIAŁA</strong>. Jeśli masz kontuzję lub z jakiegoś powodu nie chcesz trenować konkretnej partii, zaznacz ją poniżej. Algorytm pominie ją i wypełni lukę innymi ćwiczeniami.</p>
        
        <form action="{{ path('app_generator_build') }}" method="POST">
            <div class="row mb-4">
                {% for muscle in muscles %}
                    <div class="col-md-4 mb-3">
                        <div class="form-check form-switch fs-5">
                            <input class="form-check-input" type="checkbox" role="switch" name="excluded_muscles[]" value="{{ muscle.id }}" id="m_{{ muscle.id }}">
                            <label class="form-check-label text-danger" for="m_{{ muscle.id }}">
                                Pomijaj: {{ muscle.name }}
                            </label>
                        </div>
                    </div>
                {% endfor %}
            </div>
            <div class="d-flex justify-content-between">
                <a href="{{ path('app_generator_duration') }}" class="btn btn-outline-secondary">Wróć</a>
                <button type="submit" class="btn btn-danger btn-lg fw-bold">Generuj Plan <i class="bi bi-magic"></i></button>
            </div>
        </form>
    </div>
</div>
{% endblock %}