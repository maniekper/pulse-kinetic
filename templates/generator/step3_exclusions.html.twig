{% extends 'base.html.twig' %}

{% block title %}Krok 03 - Wykluczenia | PULSE KINETIC{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#0e0e0e] flex flex-col items-center justify-center p-6 relative">
    
    <!-- Tło -->
    <div class="fixed inset-0 z-0 bg-gradient-to-b from-[#0e0e0e]/80 to-[#0e0e0e]/95 pointer-events-none"></div>

    <!-- Pływające Powiadomienia Systemowe (Toasty - Ostrzeżenia) -->
    <div class="fixed top-8 left-1/2 -translate-x-1/2 z-[99999] flex flex-col gap-4 w-full max-w-2xl px-4 pointer-events-none">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="pointer-events-auto bg-[#1a1a1a] border-l-4 {% if label == 'danger' or label == 'error' %}border-[#ff7351]{% else %}border-[#d1fc00]{% endif %} p-5 shadow-[0_20px_50px_rgba(0,0,0,0.5)] flex items-start gap-4">
                    <span class="material-symbols-outlined {% if label == 'danger' or label == 'error' %}text-[#ff7351]{% else %}text-[#d1fc00]{% endif %} text-2xl">
                        {% if label == 'danger' or label == 'error' %}warning{% else %}task_alt{% endif %}
                    </span>
                    <div class="flex-1 pt-1">
                        <span class="font-headline font-black text-xs md:text-sm text-white uppercase tracking-widest leading-relaxed">{{ message }}</span>
                    </div>
                    <button onclick="this.parentElement.remove()" class="text-[#767575] hover:text-white transition-colors pt-1 cursor-pointer">
                        <span class="material-symbols-outlined text-lg">close</span>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <!-- Główny Kontener -->
    <main class="relative z-10 w-full max-w-4xl bg-[#111111]/95 backdrop-blur-xl border-l border-t border-white/5 shadow-2xl p-8 md:p-12">
        
        <div class="absolute top-0 right-0 w-16 h-16 bg-[#ff7351]/10 -mr-8 -mt-8 rotate-45 pointer-events-none"></div>

        <!-- Nagłówek -->
        <div class="mb-12 border-b border-white/5 pb-6">
            <span class="font-headline font-black italic text-[#d1fc00] text-xl tracking-tighter block mb-2">GENERATOR PROTOKOŁU</span>
            <h1 class="font-headline font-black text-4xl md:text-5xl text-white uppercase tracking-tighter italic">
                KROK 03: <span class="text-[#ff7351]">KONTUZJE</span>
            </h1>
            <p class="font-label text-[10px] text-[#767575] uppercase tracking-[0.2em] mt-2">DODATKOWE PARAMETRY BEZPIECZEŃSTWA ORAZ WYKLUCZENIA PARTII (OPCJONALNE)</p>
        </div>

        <div class="flex items-start gap-4 p-6 border-l-4 border-[#d1fc00] bg-[#1a1a1a] mb-10 shadow-md">
            <span class="material-symbols-outlined text-[#d1fc00] text-2xl">health_and_safety</span>
            <p class="font-body text-[#767575] text-[11px] leading-relaxed uppercase tracking-wider">
                DOMYŚLNIE PROTOKÓŁ ZAKŁADA TRENING <strong class="text-white">CAŁEGO CIAŁA</strong>. JEŚLI MASZ KONTUZJĘ LUB Z INNEGO POWODU WYKLUCZASZ PARTIĘ, AKTYWUJ ZABEZPIECZENIE PONIŻEJ. SYSTEM WYPEŁNI LUKĘ INNYMI MASZYNAMI.
            </p>
        </div>

        <form action="{{ path('app_generator_build') }}" method="POST" class="space-y-12">
            
            <!-- Siatka z przełącznikami -->
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
                {% for muscle in muscles %}
                    
                    <label class="relative flex items-center justify-between cursor-pointer group bg-[#141414] border border-white/10 p-5 hover:border-[#ff7351]/50 transition-colors shadow-sm hover:shadow-lg">
                        
                        <span class="font-headline font-bold text-xs text-[#767575] uppercase tracking-widest group-hover:text-white transition-colors peer-checked:text-[#ff7351]">
                            POMIŃ: <span class="text-white">{{ muscle.name }}</span>
                        </span>
                        
                        <input type="checkbox" name="excluded_muscles[]" value="{{ muscle.id }}" class="sr-only peer">
                        
                        <!-- Customowy przełącznik (Toggle) -->
                        <div class="w-14 h-6 bg-[#1a1a1a] border border-white/20 peer-checked:bg-[#ff7351]/20 peer-checked:border-[#ff7351] transition-all relative flex-shrink-0">
                            <!-- Wewnętrzny przekaźnik -->
                            <div class="absolute top-[2px] left-[2px] w-[18px] h-[18px] bg-[#767575] peer-checked:bg-[#ff7351] peer-checked:translate-x-8 transition-transform duration-300 shadow-md"></div>
                        </div>
                        
                    </label>
                    
                {% endfor %}
            </div>

            <!-- Nawigacja i Aktywacja -->
            <div class="flex flex-col md:flex-row justify-between items-center gap-4 pt-6 border-t border-white/5">
                <a href="{{ path('app_generator_duration') }}" class="w-full md:w-auto px-8 py-4 border border-white/10 text-[#767575] hover:text-white hover:bg-white/5 font-headline font-bold text-xs uppercase tracking-widest transition-colors flex justify-center items-center gap-3">
                    <span class="material-symbols-outlined text-lg">arrow_back</span> KROK 02
                </a>
                
                <!-- Przycisk FINALIZUJĄCY generowanie bazy danych -->
                <button type="submit" class="w-full md:w-auto bg-[#ff7351] hover:bg-[#ff8a6d] py-4 px-10 flex items-center justify-center gap-3 transition-colors group">
                    <span class="font-headline font-black text-sm text-[#111111] uppercase tracking-widest">BUDUJ PROTOKÓŁ</span>
                    <span class="material-symbols-outlined text-[#111111] font-black transition-transform duration-500 group-hover:rotate-180">memory</span>
                </button>
            </div>

        </form>
    </main>
</div>
{% endblock %}