{% extends 'base.html.twig' %}
{% block title %}Krok 1 - Częstotliwość{% endblock %}
{% block body %}
<div class="container mt-5">
    
    <!-- Pasek z obecnym celem treningowym -->
    <div class="alert alert-dark border-secondary d-flex justify-content-between align-items-center mb-4 shadow-sm" role="alert">
        <div>
            <i class="bi bi-bullseye text-warning fs-4 me-2"></i>
            <span class="text-light">Aktualny cel treningowy: 
                <strong class="text-warning">{{ app.user.currentGoal ? app.user.currentGoal.name : 'Brak' }}</strong>
            </span>
        </div>
        <!-- Przycisk wywołujący ostrzeżenie (Modal) -->
        <button type="button" class="btn btn-outline-danger btn-sm" data-bs-toggle="modal" data-bs-target="#warningModal">
            Zmień cel <i class="bi bi-gear-fill"></i>
        </button>
    </div>

    <!-- Główny formularz Kroku 1 -->
    <div class="card bg-dark text-light border-secondary p-4 shadow">
        <h3 class="text-success fw-bold">Krok 1: Jak często chcesz ćwiczyć?</h3>
        <p class="text-muted mb-4">Dostosujemy plan do Twojego kalendarza.</p>
        
        <form action="{{ path('app_generator_step1_save') }}" method="POST">
            <div class="mb-4">
                <select name="days" class="form-select form-select-lg bg-dark text-light border-secondary">
                    <option value="2">2 dni w tygodniu (Polecane dla zajętych)</option>
                    <option value="3">3 dni w tygodniu</option>
                    <option value="4" selected>4 dni w tygodniu (Optymalnie - Klasyczny Split)</option>
                    <option value="5">5 dni w tygodniu</option>
                </select>
            </div>
            <button type="submit" class="btn btn-primary btn-lg">Dalej <i class="bi bi-arrow-right"></i></button>
        </form>
    </div>
</div>

<!-- OSTRZEGAWCZY MODAL (Wyskakujące okno) -->
<div class="modal fade" id="warningModal" tabindex="-1" aria-labelledby="warningModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content bg-dark text-light border-danger">
      
      <div class="modal-header border-secondary bg-danger bg-opacity-25">
        <h5 class="modal-title text-danger fw-bold" id="warningModalLabel">
            <i class="bi bi-exclamation-triangle-fill"></i> ISTOTNA ZMIANA
        </h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      
      <form action="{{ path('app_generator_change_goal') }}" method="POST">
          <div class="modal-body">
            <p class="fs-5">Czy na pewno chcesz zmienić cel treningowy?</p>
            <p class="text-muted small">
                Zmiana celu (np. z budowy siły na redukcję) to <strong>radykalna zmiana mechaniki treningu</strong>. 
                Algorytm całkowicie zrewolucjonizuje Twoje przyszłe plany: zmieni przydział serii, wymusi inne zakresy powtórzeń oraz zmodyfikuje czas przerw między ćwiczeniami, aby chronić Twój układ nerwowy.
            </p>
            
            <hr class="border-secondary">
            
            <div class="mb-3 mt-3">
                <label class="form-label text-warning fw-bold">Wybierz nowy kierunek rozwoju:</label>
                <select name="new_goal_id" class="form-select bg-dark text-light border-secondary">
                    {% for goal in goals %}
                        <option value="{{ goal.id }}" {% if app.user.currentGoal and app.user.currentGoal.id == goal.id %}selected{% endif %}>
                            {{ goal.name }}
                        </option>
                    {% endfor %}
                </select>
            </div>
          </div>
          
          <div class="modal-footer border-secondary">
            <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Anuluj</button>
            <button type="submit" class="btn btn-danger fw-bold">Akceptuję, zmień cel</button>
          </div>
      </form>
      
    </div>
  </div>
</div>
{% endblock %}