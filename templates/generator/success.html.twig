{% extends 'base.html.twig' %}
{% block title %}Twój Nowy Plan{% endblock %}
{% block body %}
<div class="container mt-5">
    <div class="text-center mb-4">
        <h2 class="text-success fw-bold">🎉 Plan gotowy!</h2>
        <p class="text-muted">Algorytm ułożył kompletny plan treningowy omijając Twoje kontuzje.</p>
    </div>
    
    <div class="card bg-dark text-light border-secondary p-4 shadow-sm">
        <h3 class="text-warning fw-bold mb-4">{{ plan.name }}</h3>
        
        <div class="row">
            {% for sessionNum, exercises in sessions %}
                <div class="col-md-6 mb-4">
                    <div class="card border-secondary text-light h-100" style="background-color: #2c3034;">
                        <div class="card-header fw-bold text-success border-secondary d-flex justify-content-between">
                            <span>Trening nr {{ sessionNum }}</span>
                        </div>
                        <ul class="list-group list-group-flush">
                            {% for ex in exercises %}
                                <li class="list-group-item bg-transparent text-light border-secondary d-flex justify-content-between align-items-center">
                                    <span>{{ ex.machine.name }}</span>
                                    <span class="badge bg-primary rounded-pill">{{ ex.sets }}x{{ ex.reps }}</span>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="mt-4 text-center">
            <a href="{{ path('app_generator_start') }}" class="btn btn-outline-light">Utwórz inny plan</a>
        </div>
    </div>
</div>
{% endblock %}