{% extends 'base.html.twig' %}

{% block title %}Kreator Planu - Krok 3{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card p-4 shadow-sm border-secondary bg-dark text-light">
                <h3 class="fw-bold mb-3 text-success">🤖 Inteligentny Trener</h3>
                <p class="text-muted mb-4">Krok 3: Wybierz maszyny i ćwiczenia dla swoich partii mięśniowych:</p>

                <form action="{{ path('app_generator_save_machines') }}" method="POST">
                    
                    {% for group in muscleGroups %}
                        <div class="mb-4 p-3 border border-secondary rounded">
                            <h5 class="text-warning mb-3">{{ group.name }}</h5>
                            
                            <div class="row">
                                {% if group.machines|length > 0 %}
                                    {% for machine in group.machines %}
                                        <div class="col-md-6 mb-2">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="machines[]" value="{{ machine.id }}" id="machine{{ machine.id }}">
                                                <label class="form-check-label" for="machine{{ machine.id }}">
                                                    {{ machine.name }}
                                                </label>
                                            </div>
                                        </div>
                                    {% endfor %}
                                {% else %}
                                    <p class="text-muted small mb-0">Brak maszyn przypisanych do tej partii w bazie danych.</p>
                                {% endif %}
                            </div>
                        </div>
                    {% endfor %}
                    
                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('app_generator_muscles') }}" class="btn btn-outline-secondary">Wróć</a>
                        <button type="submit" class="btn btn-primary fw-bold btn-lg">Generuj Plan <i class="bi bi-magic"></i></button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>
{% endblock %}
