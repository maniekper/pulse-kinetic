{% extends 'app_layout.html.twig' %}

{% block title %}Statystyki Systemu | PULSE KINETIC{% endblock %}

{% block app_content %}
    <main class="kinetic-bg-container">
        <div class="kinetic-bg-gradient"></div>

        <header class="kinetic-main-header">
            <div class="kinetic-main-header-stripe"></div>
            <div>
                <h1 class="kinetic-main-header-title">PANEL <span class="text-[color:var(--theme-main)]">STATYSTYK</span></h1>
                <p class="kinetic-main-header-subtitle">ANALITYKA UŻYTKOWNIKÓW, RETENCJI, TONAŻU ORAZ WYKORZYSTANIA SPRZĘTU</p>
            </div>

            <div class="flex flex-wrap items-center gap-3">
                <!-- Przełącznik zakresu 7 / 30 dni -->
                <div class="inline-flex bg-[#141414] border border-white/10 p-1">
                    <a
                        href="{{ path('app_admin_stats', {'days': 7}) }}"
                        class="px-3.5 py-2 font-headline text-xs uppercase tracking-widest transition-colors {{ days == 7 ? 'bg-[color:var(--theme-main)] text-[color:var(--theme-text)] font-black' : 'text-[#767575] hover:text-white font-bold' }}"
                    >
                        7 DNI
                    </a>
                    <a
                        href="{{ path('app_admin_stats', {'days': 30}) }}"
                        class="px-3.5 py-2 font-headline text-xs uppercase tracking-widest transition-colors {{ days == 30 ? 'bg-[color:var(--theme-main)] text-[color:var(--theme-text)] font-black' : 'text-[#767575] hover:text-white font-bold' }}"
                    >
                        30 DNI
                    </a>
                </div>

                <span class="bg-[#1a1a1a] px-4 py-2.5 border border-white/10 font-headline font-bold text-xs tracking-widest text-[#767575]">
                    KONTA: <strong class="text-white">{{ totalUsers }}</strong>
                </span>
            </div>
        </header>

        <!-- SEKCJA 1: WYKRES AKTYWNOŚCI UŻYTKOWNIKÓW -->
        <section class="relative z-10 mb-10">
            <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-4 mb-5">
                <div class="kinetic-section-title-wrap">
                    <h2 class="kinetic-section-title">ANALIZA DZIENNA UŻYTKOWNIKÓW (OSTATNIE {{ days }} DNI)</h2>
                </div>

                <div class="flex flex-wrap items-center gap-3">
                    <!-- Filtr TOP 5 / WSZYSCY -->
                    {% if totalUsers > 5 %}
                        <div class="inline-flex bg-[#141414] border border-white/10 p-1">
                            <button
                                type="button"
                                data-scope="top5"
                                onclick="switchAdminChartScope('top5')"
                                class="admin-chart-scope px-3 py-2 font-headline font-black text-[11px] uppercase tracking-widest transition-colors bg-white/15 text-white cursor-pointer"
                            >
                                TOP 5
                            </button>
                            <button
                                type="button"
                                data-scope="all"
                                onclick="switchAdminChartScope('all')"
                                class="admin-chart-scope px-3 py-2 font-headline font-bold text-[11px] uppercase tracking-widest transition-colors text-[#767575] hover:text-white cursor-pointer"
                            >
                                WSZYSCY ({{ totalUsers }})
                            </button>
                        </div>
                    {% endif %}

                    <!-- Zakładki przełączające oś Y -->
                    <div class="inline-flex bg-[#141414] border border-white/10 p-1">
                        <button
                            type="button"
                            data-metric="tonnage"
                            onclick="switchAdminChartMetric('tonnage')"
                            class="admin-chart-tab px-4 py-2 font-headline font-black text-xs uppercase tracking-widest transition-colors bg-[color:var(--theme-main)] text-[color:var(--theme-text)] cursor-pointer"
                        >
                            Tonaż (kg)
                        </button>
                        <button
                            type="button"
                            data-metric="sessions"
                            onclick="switchAdminChartMetric('sessions')"
                            class="admin-chart-tab px-4 py-2 font-headline font-bold text-xs uppercase tracking-widest transition-colors text-[#767575] hover:text-white cursor-pointer"
                        >
                            Sesje
                        </button>
                        <button
                            type="button"
                            data-metric="logins"
                            onclick="switchAdminChartMetric('logins')"
                            class="admin-chart-tab px-4 py-2 font-headline font-bold text-xs uppercase tracking-widest transition-colors text-[#767575] hover:text-white cursor-pointer"
                        >
                            Logowania
                        </button>
                    </div>
                </div>
            </div>

            <div class="kinetic-panel">
                <div class="relative w-full h-[320px] md:h-[380px]">
                    <canvas id="adminActivityChart"></canvas>
                </div>
            </div>
        </section>

        <!-- SEKCJA 2: DZISIEJSZA AKTYWNOŚĆ -->
        <section class="relative z-10 mb-10">
            <div class="kinetic-section-title-wrap mb-5">
                <h2 class="kinetic-section-title">DZISIEJSZA AKTYWNOŚĆ (OD 00:00)</h2>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="kinetic-panel flex flex-col justify-between gap-4">
                    <div class="flex items-center justify-between">
                        <span class="font-label text-[10px] text-[#767575] uppercase tracking-widest">ZALOGOWANI DZIŚ</span>
                        <span class="material-symbols-outlined text-[color:var(--theme-main)]">person_check</span>
                    </div>
                    <div class="font-headline font-black text-4xl text-white tracking-tight">
                        {{ loggedInToday }}
                    </div>
                    <p class="font-body text-xs text-[#767575]">Unikalne konta aktywne dzisiaj</p>
                </div>

                <div class="kinetic-panel flex flex-col justify-between gap-4">
                    <div class="flex items-center justify-between">
                        <span class="font-label text-[10px] text-[#767575] uppercase tracking-widest">UKOŃCZONE SESJE DZIŚ</span>
                        <span class="material-symbols-outlined text-[color:var(--theme-main)]">fitness_center</span>
                    </div>
                    <div class="font-headline font-black text-4xl text-white tracking-tight">
                        {{ sessionsToday }}
                    </div>
                    <p class="font-body text-xs text-[#767575]">Zakończone treningi w dniu dzisiejszym</p>
                </div>

                <div class="kinetic-panel flex flex-col justify-between gap-4">
                    <div class="flex items-center justify-between">
                        <span class="font-label text-[10px] text-[#767575] uppercase tracking-widest">TONAŻ DZIŚ</span>
                        <span class="material-symbols-outlined text-[color:var(--theme-main)]">weight</span>
                    </div>
                    <div>
                        <div class="font-headline font-black text-4xl text-[color:var(--theme-main)] tracking-tight">
                            {{ (tonnageTodayKg / 1000)|number_format(2, ',', ' ') }} <span class="text-lg text-white">T</span>
                        </div>
                        <div class="font-label text-xs text-[#9e9e9e] mt-1">
                            ({{ tonnageTodayKg|number_format(0, ',', ' ') }} kg)
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SEKCJA 3: PODSUMOWANIE OKRESU + RETENCJA I KONDYCJA TRENINGÓW -->
        <section class="relative z-10 mb-10">
            <div class="kinetic-section-title-wrap mb-5">
                <h2 class="kinetic-section-title">PODSUMOWANIE I RETENCJA (OSTATNIE {{ days }} DNI)</h2>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <!-- Aktywni ćwiczący (retencja treningowa) -->
                <div class="kinetic-panel flex flex-col justify-between gap-4">
                    <div class="flex items-center justify-between">
                        <span class="font-label text-[10px] text-[#767575] uppercase tracking-widest">AKTYWNI ĆWICZĄCY</span>
                        <span class="material-symbols-outlined text-[color:var(--theme-main)]">directions_run</span>
                    </div>
                    <div class="flex items-baseline gap-2">
                        <span class="font-headline font-black text-4xl text-white tracking-tight">{{ activeTrainersPeriod }}</span>
                        <span class="font-label text-xs text-[#767575]">/ {{ totalUsers }} kont</span>
                    </div>
                    <p class="font-body text-xs text-[#767575]">
                        Zalogowanych w okresie: <strong class="text-white">{{ loggedInPeriod }}</strong>
                    </p>
                </div>

                <!-- Ukończone sesje vs porzucone -->
                <div class="kinetic-panel flex flex-col justify-between gap-4">
                    <div class="flex items-center justify-between">
                        <span class="font-label text-[10px] text-[#767575] uppercase tracking-widest">SESJE UKOŃCZONE / PORZUCONE</span>
                        <span class="material-symbols-outlined text-[color:var(--theme-main)]">event_available</span>
                    </div>
                    <div class="flex items-baseline gap-3">
                        <span class="font-headline font-black text-4xl text-white tracking-tight">{{ sessionsPeriod }}</span>
                        <span class="font-headline font-bold text-lg {{ abandonedSessionsPeriod > 0 ? 'text-error' : 'text-[#767575]' }}">
                            / {{ abandonedSessionsPeriod }} porz.
                        </span>
                    </div>
                    <p class="font-body text-xs text-[#767575]">
                        Skuteczność domykania treningów: <strong class="text-white">{{ completionRatePercent }}%</strong>
                    </p>
                </div>

                <!-- Tonaż w okresie i średnia na sesję -->
                <div class="kinetic-panel flex flex-col justify-between gap-4">
                    <div class="flex items-center justify-between">
                        <span class="font-label text-[10px] text-[#767575] uppercase tracking-widest">TONAŻ OKRESU (ŚR. NA SESJĘ)</span>
                        <span class="material-symbols-outlined text-[color:var(--theme-main)]">monitoring</span>
                    </div>
                    <div>
                        <div class="font-headline font-black text-4xl text-[color:var(--theme-main)] tracking-tight">
                            {{ (tonnagePeriodKg / 1000)|number_format(2, ',', ' ') }} <span class="text-lg text-white">T</span>
                        </div>
                        <div class="font-label text-xs text-[#9e9e9e] mt-1">
                            Średnio: <strong class="text-white">{{ avgTonnagePerSessionKg|number_format(0, ',', ' ') }} kg</strong> / trening
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SEKCJA 4: ANALITYKA MASZYN (TOP UŻYWANE VS NAJCZĘŚCIEJ BANOWANE) -->
        <section class="relative z-10">
            <div class="kinetic-section-title-wrap mb-5">
                <h2 class="kinetic-section-title">ANALITYKA SPRZĘTU (OSTATNIE {{ days }} DNI / WYKLUCZENIA)</h2>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- TOP 5 Najpopularniejsze maszyny -->
                <div class="kinetic-panel">
                    <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
                        <div>
                            <h3 class="font-headline font-black text-sm text-white uppercase tracking-widest">TOP 5 NAJCZĘŚCIEJ UŻYWANYCH</h3>
                            <p class="font-label text-[10px] text-[#767575] uppercase tracking-wider mt-0.5">WG LICZBY UKOŃCZONYCH SERII W OKRESIE</p>
                        </div>
                        <span class="material-symbols-outlined text-[color:var(--theme-main)]">trending_up</span>
                    </div>

                    {% if topUsedMachines|length > 0 %}
                        <div class="divide-y divide-white/5">
                            {% for item in topUsedMachines %}
                                <div class="py-3 flex items-center justify-between gap-4">
                                    <div class="min-w-0">
                                        <div class="font-headline font-bold text-sm text-white uppercase truncate">
                                            {{ loop.index }}. {{ item.name }}
                                        </div>
                                        <div class="font-label text-[10px] text-[#767575] uppercase tracking-widest">
                                            {{ item.category|default('Brak kategorii') }}
                                        </div>
                                    </div>
                                    <div class="text-right shrink-0">
                                        <div class="font-headline font-black text-sm text-[color:var(--theme-main)]">
                                            {{ item.setsCount }} serii
                                        </div>
                                        <div class="font-label text-[10px] text-[#9e9e9e]">
                                            {{ (item.totalTonnage / 1000)|number_format(2, ',', ' ') }} T
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="font-body text-xs text-[#767575] py-6 text-center">Brak ukończonych serii w wybranym okresie.</p>
                    {% endif %}
                </div>

                <!-- TOP 5 Najczęściej banowane maszyny -->
                <div class="kinetic-panel">
                    <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
                        <div>
                            <h3 class="font-headline font-black text-sm text-white uppercase tracking-widest">TOP 5 NAJCZĘŚCIEJ BANOWANYCH</h3>
                            <p class="font-label text-[10px] text-[#767575] uppercase tracking-wider mt-0.5">SPRZĘT WYKLUCZANY PRZEZ UŻYTKOWNIKÓW</p>
                        </div>
                        <span class="material-symbols-outlined text-error">block</span>
                    </div>

                    {% if topBannedMachines|length > 0 %}
                        <div class="divide-y divide-white/5">
                            {% for item in topBannedMachines %}
                                <div class="py-3 flex items-center justify-between gap-4">
                                    <div class="min-w-0">
                                        <div class="font-headline font-bold text-sm text-white uppercase truncate">
                                            {{ loop.index }}. {{ item.name }}
                                        </div>
                                        <div class="font-label text-[10px] text-[#767575] uppercase tracking-widest">
                                            {{ item.category }}
                                        </div>
                                    </div>
                                    <div class="shrink-0 bg-error/10 border border-error/30 px-3 py-1">
                                        <span class="font-headline font-black text-xs text-error uppercase tracking-widest">
                                            {{ item.bansCount }} {{ item.bansCount == 1 ? 'ban' : 'banów' }}
                                        </span>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="font-body text-xs text-[#767575] py-6 text-center">Żaden użytkownik nie wykluczył jeszcze żadnej maszyny.</p>
                    {% endif %}
                </div>
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script>
        const adminChartData = {{ chartPayload|json_encode|raw }};
        let adminActivityChartInstance = null;
        let currentMetric = 'tonnage';
        let currentScope = 'top5';

        function buildDatasets(metricKey, scopeKey) {
            const list = adminChartData[metricKey] || [];
            const filtered = scopeKey === 'top5' ? list.filter(item => item.isTop5) : list;

            return filtered.map(item => ({
                label: item.label,
                data: item.data,
                borderColor: item.color,
                backgroundColor: item.color,
                borderWidth: 2.5,
                pointRadius: adminChartData.days > 14 ? 2.5 : 4,
                pointHoverRadius: 6,
                tension: 0.25,
                fill: false
            }));
        }

        function getMetricMeta(metricKey) {
            if (metricKey === 'sessions') {
                return {
                    title: 'Liczba ukończonych sesji',
                    stepSize: 1,
                    max: undefined,
                    unit: ' sesji',
                    yTickFormatter: (val) => val
                };
            }
            if (metricKey === 'logins') {
                return {
                    title: 'Status ostatniego logowania',
                    stepSize: 1,
                    max: 1,
                    unit: '',
                    yTickFormatter: (val) => (val === 1 ? 'Tak (1)' : (val === 0 ? 'Nie (0)' : ''))
                };
            }
            return {
                title: 'Przerzucony tonaż (kg)',
                stepSize: undefined,
                max: undefined,
                unit: ' kg',
                yTickFormatter: (val) => `${val} kg`
            };
        }

        function refreshAdminChart() {
            if (!adminActivityChartInstance) return;
            const meta = getMetricMeta(currentMetric);

            adminActivityChartInstance.data.datasets = buildDatasets(currentMetric, currentScope);
            adminActivityChartInstance.options.scales.y.title.text = meta.title;
            adminActivityChartInstance.options.scales.y.ticks.stepSize = meta.stepSize;
            adminActivityChartInstance.options.scales.y.max = meta.max;
            adminActivityChartInstance.options.scales.y.ticks.callback = meta.yTickFormatter;

            adminActivityChartInstance.options.plugins.tooltip.callbacks.label = function (ctx) {
                if (currentMetric === 'logins') {
                    return ` ${ctx.dataset.label}: ${ctx.parsed.y === 1 ? 'Zalogowany' : 'Brak logowania'}`;
                }
                return ` ${ctx.dataset.label}: ${ctx.parsed.y}${meta.unit}`;
            };

            adminActivityChartInstance.update();
        }

        window.switchAdminChartMetric = function (metricKey) {
            currentMetric = metricKey;

            document.querySelectorAll('.admin-chart-tab').forEach(btn => {
                const isActive = btn.getAttribute('data-metric') === metricKey;
                btn.classList.toggle('bg-[color:var(--theme-main)]', isActive);
                btn.classList.toggle('text-[color:var(--theme-text)]', isActive);
                btn.classList.toggle('font-black', isActive);
                btn.classList.toggle('text-[#767575]', !isActive);
                btn.classList.toggle('font-bold', !isActive);
            });

            refreshAdminChart();
        };

        window.switchAdminChartScope = function (scopeKey) {
            currentScope = scopeKey;

            document.querySelectorAll('.admin-chart-scope').forEach(btn => {
                const isActive = btn.getAttribute('data-scope') === scopeKey;
                btn.classList.toggle('bg-white/15', isActive);
                btn.classList.toggle('text-white', isActive);
                btn.classList.toggle('font-black', isActive);
                btn.classList.toggle('text-[#767575]', !isActive);
                btn.classList.toggle('font-bold', !isActive);
            });

            refreshAdminChart();
        };

        document.addEventListener('DOMContentLoaded', () => {
            const canvas = document.getElementById('adminActivityChart');
            if (!canvas || typeof Chart === 'undefined') return;

            const meta = getMetricMeta(currentMetric);

            adminActivityChartInstance = new Chart(canvas, {
                type: 'line',
                data: {
                    labels: adminChartData.labels || [],
                    datasets: buildDatasets(currentMetric, currentScope)
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                color: '#e5e5e5',
                                usePointStyle: true,
                                pointStyle: 'circle',
                                padding: 18,
                                font: {
                                    family: 'Space Grotesk, sans-serif',
                                    weight: '700',
                                    size: 11
                                }
                            }
                        },
                        tooltip: {
                            backgroundColor: '#111111',
                            borderColor: 'rgba(255,255,255,0.15)',
                            borderWidth: 1,
                            titleColor: '#ffffff',
                            bodyColor: '#e5e5e5',
                            padding: 12,
                            callbacks: {
                                label: function (ctx) {
                                    return ` ${ctx.dataset.label}: ${ctx.parsed.y}${meta.unit}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: {
                                color: 'rgba(255, 255, 255, 0.06)'
                            },
                            ticks: {
                                color: '#9e9e9e',
                                maxTicksLimit: 10,
                                font: {
                                    family: 'Space Grotesk, sans-serif',
                                    weight: '700',
                                    size: 11
                                }
                            },
                            title: {
                                display: true,
                                text: `Dni (ostatnie ${adminChartData.days} dni)`,
                                color: '#767575',
                                font: {
                                    family: 'Space Grotesk, sans-serif',
                                    weight: '700',
                                    size: 11
                                }
                            }
                        },
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.06)'
                            },
                            ticks: {
                                color: '#9e9e9e',
                                precision: 0,
                                callback: meta.yTickFormatter,
                                font: {
                                    family: 'Space Grotesk, sans-serif',
                                    weight: '700',
                                    size: 11
                                }
                            },
                            title: {
                                display: true,
                                text: meta.title,
                                color: '#767575',
                                font: {
                                    family: 'Space Grotesk, sans-serif',
                                    weight: '700',
                                    size: 11
                                }
                            }
                        }
                    }
                }
            });
        });
    </script>
{% endblock %}
