{% extends 'base.html.twig' %}
{% block title %}KINETIC_LAB | Active Workout{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- Czcionki Google przeniesione/zostawione jako linki zewnętrzne -->
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
    <!-- GIGANTYCZNY EKRAN STARTOWY (OVERLAY) -->
    {% include 'components/_tracker_ready_overlay.html.twig' %}

    <div class="bg-surface text-on-surface font-body selection:bg-primary-container selection:text-on-primary-container min-h-screen">
        <!-- EKRAN PRZERWY DLA WERSJI MOBILNEJ -->
        <div id="mobileRestOverlay" class="fixed inset-0 z-[100000] bg-[#0e0e0e]/95 backdrop-blur-xl flex-col items-center justify-center p-6 hidden">
            <h2 class="font-headline font-black text-2xl text-outline uppercase tracking-widest mb-8">ODPOCZYNEK</h2>
    
            <div class="relative flex items-center justify-center w-64 h-64 mb-8">
                <svg class="w-full h-full -rotate-90">
                    <circle class="text-surface-container-highest" cx="128" cy="128" fill="transparent" r="120" stroke="currentColor" stroke-width="8"></circle>
                    <circle id="mobileRestTimerCircle" class="text-primary-container transition-all duration-1000 ease-linear" cx="128" cy="128" fill="transparent" r="120" stroke="currentColor" stroke-dasharray="753.98" stroke-dashoffset="0" stroke-width="8" stroke-linecap="round"></circle>
                </svg>
                <div class="absolute inset-0 flex flex-col items-center justify-center">
                    <span id="mobileRestTimerDisplay" class="font-headline text-7xl font-black text-on-surface">--:--</span>
                </div>
            </div>

            <div class="flex gap-4 w-full px-2 max-w-sm relative z-50">
                <button type="button" onclick="addRestTime(30)" class="cursor-pointer flex-1 bg-surface-container-highest text-on-surface py-5 font-headline font-bold text-sm uppercase tracking-widest border border-outline-variant/30 active:bg-outline-variant transition-colors">
                    +30s
                </button>
                <button type="button" onclick="document.getElementById('mobileRestOverlay').classList.add('hidden'); document.getElementById('mobileRestOverlay').classList.remove('flex'); skipRestTime();" class="cursor-pointer flex-1 bg-primary-container text-on-primary-container py-5 font-headline font-black text-sm uppercase tracking-widest shadow-[0_0_20px_var(--theme-shadow)] active:scale-95 transition-all">
                    POMIŃ
                </button>
            </div>

            <!-- ANALIZA SERII NA EKRANIE PRZERWY MOBILNEJ -->
            <div id="mobileCoachBox" class="hidden w-full max-w-sm bg-[#161616] border-l-4 border-primary-container px-4 py-3 text-left shadow-lg mt-6">
                <div class="font-label text-[9px] font-bold text-primary-container uppercase tracking-widest mb-1">
                    ANALIZA SERII
                </div>
                <p id="mobileCoachText" class="font-body text-xs text-white leading-relaxed"></p>
                <p id="mobileNextWeightText" class="hidden font-headline font-bold text-[11px] text-primary-container uppercase tracking-wider mt-1.5"></p>
            </div>
        </div>

        <!-- TopAppBar -->
        <header class="fixed top-0 w-full border-none bg-[#0e0e0e] flex justify-between items-center px-6 h-16 z-50">
            <div class="flex items-center gap-4">
                <span class="text-xl font-black text-primary-container tracking-widest font-headline uppercase italic">PULSE KINETIC</span>
            </div>
            <div class="flex items-center gap-6">
                <div class="flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary-container">timer</span>
                    <span class="font-headline font-bold text-primary-container tracking-tighter text-lg" id="globalWorkoutTimer">00:00</span>
                </div>
            </div>
        </header>

        <!-- Własny Modal Błędu -->
        <div id="customAlertModal" class="fixed inset-0 z-[100000] bg-black/80 backdrop-blur-sm hidden items-center justify-center">
            <div class="bg-surface-container border-l-4 border-error-container p-8 max-w-md w-full mx-4 shadow-2xl relative">
                <div class="flex items-start gap-4 mb-6">
                    <span class="material-symbols-outlined text-error-container text-4xl">warning</span>
                    <div>
                        <h3 class="font-headline font-black text-xl text-white uppercase tracking-tighter mb-2">Błąd Walidacji</h3>
                        <p id="customAlertMessage" class="font-body text-on-surface-variant text-sm"></p>
                    </div>
                </div>
                <div class="flex justify-end">
                    <button type="button" onclick="closeCustomAlert()" class="bg-[#131313] hover:bg-error-container text-white px-6 py-3 font-headline font-bold text-xs uppercase tracking-widest transition-colors border border-outline-variant/30">
                        ROZUMIEM
                    </button>
                </div>
            </div>
        </div>

        <main class="pt-24 pb-64 lg:pb-36 px-4 md:px-8 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Header Section -->
            <div class="lg:col-span-12 mb-4">
                <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
                    <div>
                        <span class="font-label text-xs font-bold text-outline uppercase tracking-[0.2em] mb-1 block">Session Active</span>
                        <h1 class="font-headline text-3xl md:text-5xl font-extrabold uppercase tracking-tighter text-on-surface italic">
                            TRENING W TOKU: <span class="text-primary-container">{{ app.user.currentGoal ? app.user.currentGoal.name : 'TRENING' }}</span>
                        </h1>
                    </div>
                    <div class="w-full md:w-72">
                        <div class="flex justify-between items-end mb-2">
                            <span class="font-label text-[10px] font-bold text-outline tracking-widest uppercase">Progress</span>
                            <span class="font-headline font-bold text-primary-container" id="workoutProgressText">0%</span>
                        </div>
                        <div class="h-2 bg-surface-container-highest w-full sheared-progress">
                            <div class="h-full bg-primary-container w-0" id="workoutProgressBar" style="transition: width 0.3s ease;"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Execution Area -->
            <div class="lg:col-span-8 relative" id="exercisesContainer">
                {% for machineName, sets in groupedSets %}
                    {% set primaryMuscleNames = [] %}
                    {% for m in sets[0].machine.primaryMuscles %}
                        {% set primaryMuscleNames = primaryMuscleNames|merge([m.name]) %}
                    {% endfor %}
                    {% set secondaryMuscleNames = [] %}
                    {% for m in sets[0].machine.secondaryMuscles %}
                        {% set secondaryMuscleNames = secondaryMuscleNames|merge([m.name]) %}
                    {% endfor %}

                    {% set userSteps = app.user.exerciseIncrementSteps is defined and app.user.exerciseIncrementSteps is not null ? app.user.exerciseIncrementSteps : {} %}
                    {% set machineKey = '' ~ sets[0].machine.id %}
                    {% set effectiveStep = userSteps[machineKey] is defined ? userSteps[machineKey] : (sets[0].machine.incrementStep|default(2.5)) %}

                    <!-- BLOK ĆWICZENIA -->
                    <section
                        class="bg-surface-container p-6 relative exercise-block"
                        data-machine-id="{{ sets[0].machine.id }}"
                        data-increment-step="{{ effectiveStep }}"
                        data-unit="kg"
                        data-primary-muscles="{{ primaryMuscleNames|join(',') }}"
                        data-secondary-muscles="{{ secondaryMuscleNames|join(',') }}"
                        data-rest-time="{{ restTimes[machineName] }}"
                        style="display: none;"
                    >
                        <div class="flex flex-col gap-6">
                            <div class="flex flex-col gap-6 items-start">
                                <div class="flex-1 flex flex-col w-full">
                                    
                                    <!-- NAGŁÓWEK Z PRZYCISKIEM POMINIĘCIA -->
                                    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-6 gap-4 border-b border-outline-variant/20 pb-4">
                                        <h2 class="font-headline text-3xl md:text-4xl font-black uppercase leading-none tracking-tighter italic m-0">
                                            <span class="ex-number text-primary-container">{{ loop.index > 9 ? loop.index : '0' ~ loop.index }}</span>. {{ machineName }}
                                        </h2>
                                        <button type="button" onclick="skipOccupiedMachine()" class="shrink-0 bg-[#131313] border border-outline-variant/30 text-[#767575] hover:text-primary-container hover:border-primary-container/50 px-4 py-2 font-headline font-bold text-[10px] uppercase tracking-widest flex items-center gap-2 transition-all cursor-pointer shadow-lg">
                                            <span class="material-symbols-outlined text-sm">skip_next</span>
                                            NASTĘPNE ĆWICZENIE
                                        </button>
                                    </div>
                                
                                    <!-- Zdjęcia Maszyny -->
                                    <div class="w-full flex flex-col gap-4 shrink-0 mb-8 max-w-4xl mx-auto">
                                        <div class="grid grid-cols-2 gap-6">
                                            <!-- FAZA 1 -->
                                            <div class="relative bg-[#1a1a1a] border border-white/10 flex items-center justify-center overflow-hidden aspect-[4/5] shadow-xl">
                                                <span class="absolute top-4 left-4 bg-black px-3 py-1.5 font-headline font-black text-[12px] text-white tracking-widest uppercase z-10 border border-white/20">F1</span>
                                                <img src="{{ asset('images/machines/' ~ sets[0].machine.imageStart) }}" class="w-full h-full object-cover mix-blend-luminosity opacity-90">
                                            </div>
                                            <!-- FAZA 2 -->
                                            <div class="relative bg-[#1a1a1a] border border-white/10 flex items-center justify-center overflow-hidden aspect-[4/5] shadow-xl">
                                                <span class="absolute top-4 left-4 bg-black px-3 py-1.5 font-headline font-black text-[12px] text-white tracking-widest uppercase z-10 border border-white/20">F2</span>
                                                <img src="{{ asset('images/machines/' ~ sets[0].machine.imageEnd) }}" class="w-full h-full object-cover mix-blend-luminosity opacity-90">
                                            </div>
                                        </div>
                                    </div>
                                
                                    <p class="text-on-surface-variant font-body text-sm max-w-2xl mb-8 leading-relaxed">
                                        {{ sets[0].machine.description }}
                                    </p>

                                    {% if sets[0].machine.tips %}
                                        <div class="max-w-2xl mb-8 bg-[#131313] border-l-2 border-primary-container p-4">
                                            <div class="font-headline font-bold text-[10px] text-primary-container uppercase tracking-widest mb-1">
                                                TIPS / WSKAZÓWKI DODATKOWE
                                            </div>
                                            <p class="text-on-surface-variant font-body text-xs leading-relaxed m-0">
                                                {{ sets[0].machine.tips|nl2br }}
                                            </p>
                                        </div>
                                    {% endif %}

                                    <!-- Nagłówki tabeli -->
                                    <div class="grid grid-cols-12 gap-2 md:gap-4 px-2 md:px-6 py-4 border-b border-outline-variant/20 items-center">
                                        <div class="col-span-2 font-headline text-[10px] font-bold text-outline tracking-tighter uppercase">Set</div>
                                        <div class="col-span-4 flex justify-center">
                                            <div class="inline-flex border border-outline-variant/40 bg-[#131313]" role="group" aria-label="Jednostka ciężaru">
                                                <button
                                                    type="button"
                                                    data-unit-toggle="kg"
                                                    onclick="setExerciseUnit(this, 'kg')"
                                                    class="px-2.5 py-1 font-headline text-[10px] font-black uppercase tracking-widest bg-primary-container text-on-primary-container cursor-pointer transition-colors"
                                                >
                                                    KG
                                                </button>
                                                <button
                                                    type="button"
                                                    data-unit-toggle="lbs"
                                                    onclick="setExerciseUnit(this, 'lbs')"
                                                    class="px-2.5 py-1 font-headline text-[10px] font-bold uppercase tracking-widest text-outline hover:text-white cursor-pointer transition-colors"
                                                >
                                                    LBS
                                                </button>
                                            </div>
                                        </div>
                                        <div class="col-span-4 font-headline text-[10px] font-bold text-outline tracking-tighter uppercase text-center">REPS</div>
                                        <div class="col-span-2 text-right"></div>
                                    </div>

                                    <!-- Serie -->
                                    {% for set in sets %}
                                        <div id="set-row-{{ set.id }}" class="grid grid-cols-12 gap-2 md:gap-4 px-2 md:px-6 py-3 items-center set-row relative {% if set.isCompleted %}opacity-50 bg-surface-container-low{% else %}kinetic-stripe bg-surface-container-high{% endif %}" data-set-id="{{ set.id }}" data-target-reps="{{ set.reps }}">                                        
                                            <div class="col-span-2 font-headline font-bold text-xl md:text-2xl set-number {% if set.isCompleted %}text-on-surface{% else %}text-primary-container{% endif %}">
                                                {{ set.setNumber > 9 ? set.setNumber : '0' ~ set.setNumber }}
                                            </div>
                                        
                                            <!-- CIĘŻAR (KG / LBS -> ZAPIS W KG) -->
                                            <div class="col-span-4 px-1 md:px-2">
                                                {% if set.isCompleted %}
                                                    <div class="bg-surface-container-highest py-2.5 text-center font-headline font-black text-xl text-on-surface completed-weight-display" data-weight-kg="{{ set.weight }}">{{ set.weight }}</div>
                                                {% else %}
                                                    <div class="flex items-stretch h-11 border border-outline-variant/30 bg-[#131313]">
                                                        <button type="button" onclick="adjustWeightValue('weight-{{ set.id }}', -1)" class="w-8 md:w-10 bg-surface-container-highest text-outline hover:text-primary-container hover:bg-[#1a1a1a] transition-colors font-bold text-xl flex items-center justify-center shrink-0 cursor-pointer">-</button>
                                                        <input
                                                            type="number"
                                                            step="any"
                                                            id="weight-{{ set.id }}"
                                                            data-weight-kg="{{ set.weight > 0 ? set.weight : '' }}"
                                                            class="weight-input w-full bg-transparent border-none text-center font-headline font-black text-xl focus:ring-0 text-on-surface p-0 m-0"
                                                            value="{{ set.weight > 0 ? set.weight : '' }}"
                                                        >
                                                        <button type="button" onclick="adjustWeightValue('weight-{{ set.id }}', 1)" class="w-8 md:w-10 bg-surface-container-highest text-outline hover:text-primary-container hover:bg-[#1a1a1a] transition-colors font-bold text-xl flex items-center justify-center shrink-0 cursor-pointer">+</button>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        
                                            <!-- POWTÓRZENIA -->
                                            <div class="col-span-4 px-1 md:px-2">
                                                {% if set.isCompleted %}
                                                    <div class="bg-surface-container-highest py-2.5 text-center font-headline font-black text-xl text-on-surface">{{ set.reps }}</div>
                                                {% else %}
                                                    <div class="flex items-stretch h-11 border border-outline-variant/30 bg-[#131313]">
                                                        <button type="button" onclick="adjustValue('reps-{{ set.id }}', -1)" class="w-8 md:w-10 bg-surface-container-highest text-outline hover:text-primary-container hover:bg-[#1a1a1a] transition-colors font-bold text-xl flex items-center justify-center shrink-0 cursor-pointer">-</button>
                                                        <input type="number" step="1" id="reps-{{ set.id }}" class="w-full bg-transparent border-none text-center font-headline font-black text-xl focus:ring-0 text-on-surface p-0 m-0" value="{{ set.reps > 0 ? set.reps : '' }}">
                                                        <button type="button" onclick="adjustValue('reps-{{ set.id }}', 1)" class="w-8 md:w-10 bg-surface-container-highest text-outline hover:text-primary-container hover:bg-[#1a1a1a] transition-colors font-bold text-xl flex items-center justify-center shrink-0 cursor-pointer">+</button>
                                                    </div>
                                                {% endif %}
                                            </div>
                                        
                                            <div class="col-span-2 text-right pe-2 set-action-container">
                                                {% if set.isCompleted %}
                                                    <span class="material-symbols-outlined text-primary-container">check_circle</span>
                                                {% else %}
                                                    <button class="material-symbols-outlined text-outline hover:text-primary-container transition-colors save-set-btn cursor-pointer text-3xl" onclick="saveSet({{ set.id }}, this)">check</button>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}

                                    <!-- WIRTUALNY TRENER -->
                                    <div id="coach-message-box-{{ sets[0].machine.id }}" class="hidden mb-4 mx-2 md:mx-6 bg-[#131313] border-l-4 border-primary-container p-4 shadow-2xl relative overflow-hidden transition-all duration-500 transform translate-y-[-10px] opacity-0">
                                        <div class="absolute -right-10 -top-10 w-40 h-40 bg-primary-container/5 rounded-full blur-3xl"></div>
                                        <div class="flex items-start gap-4 relative z-10">
                                            <span class="material-symbols-outlined text-primary-container text-3xl animate-bounce" style="animation-duration: 2s;">tips_and_updates</span>
                                            <div>
                                                <h3 class="font-headline font-black text-xs text-outline uppercase tracking-[0.2em] mb-1">Analiza Serii</h3>
                                                <p id="coach-message-text-{{ sets[0].machine.id }}" class="font-body text-on-surface text-sm leading-relaxed font-medium"></p>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- MODUŁ CARDIO (ZWIJANY PASEK) -->
                                    <details class="mt-8 mb-6 bg-surface-container border border-outline-variant/30 group">
                                        <summary class="list-none cursor-pointer p-4 md:p-5 flex items-center justify-between hover:bg-white/5 transition-colors select-none">
                                            <div class="flex items-center gap-3">
                                                <span class="material-symbols-outlined text-primary-container text-2xl">directions_run</span>
                                                <div class="flex flex-col">
                                                    <span class="font-headline text-sm md:text-base font-black text-on-surface uppercase tracking-wider italic">
                                                        Dodaj Cardio Dziś
                                                    </span>
                                                    {% if session.cardioSessions|length > 0 %}
                                                        <span class="font-label text-[10px] text-primary-container uppercase tracking-widest font-bold">
                                                            Zapisane sesje: {{ session.cardioSessions|length }}
                                                        </span>
                                                    {% else %}
                                                        <span class="font-label text-[10px] text-outline uppercase tracking-widest">
                                                            Opcjonalne • Kliknij, aby rozwinąć
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <span class="material-symbols-outlined text-outline group-open:rotate-180 transition-transform duration-200">
                                                expand_more
                                            </span>
                                        </summary>

                                        <div class="p-4 md:p-6 pt-0 border-t border-outline-variant/20 mt-2">
                                            {% set goalName = app.user.currentGoal ? app.user.currentGoal.name|lower : '' %}
                                            <div class="bg-[#131313] p-4 border-l-2 border-primary-container my-4">
                                                <h4 class="font-headline font-bold text-outline text-[10px] uppercase tracking-widest mb-2">Wskazówka Trenerska</h4>
                                                {% if 'redukcj' in goalName or 'rzeźb' in goalName %}
                                                    <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                                                        <span class="text-primary-container font-bold">Cel: Redukcja.</span> Trening siłowy uszczuplił zapasy Twojego glikogenu. Celuj w <strong class="text-on-surface">25 - 45 minut</strong> o stałym, umiarkowanym tempie.
                                                    </p>
                                                {% elseif 'sił' in goalName %}
                                                    <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                                                        <span class="text-primary-container font-bold">Cel: Budowa Siły.</span> Zrób maksymalnie <strong class="text-on-surface">5 - 10 minut</strong> lekkiego schłodzenia (cool-down).
                                                    </p>
                                                {% else %}
                                                    <p class="font-body text-sm text-on-surface-variant leading-relaxed">
                                                        <span class="text-primary-container font-bold">Cel: Hipertrofia.</span> Zrób <strong class="text-on-surface">15 - 20 minut</strong> o umiarkowanej intensywności.
                                                    </p>
                                                {% endif %}
                                            </div>

                                            <form action="{{ path('app_tracker_add_cardio', {'id': session.id}) }}" method="POST">
                                                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end bg-[#131313] p-4 border border-outline-variant/30">
                                                    <div class="md:col-span-3">
                                                        <label class="font-headline text-[10px] font-bold text-outline tracking-tighter uppercase mb-2 block">Maszyna</label>
                                                        <select name="machine_id" required class="w-full bg-surface-container-highest border-none text-on-surface font-headline font-bold text-sm focus:ring-1 focus:ring-primary-container p-3 h-12">
                                                            <option value="">Wybierz...</option>
                                                            {% for cardio in cardioMachines %}
                                                                <option value="{{ cardio.id }}">{{ cardio.name }}</option>
                                                            {% endfor %}
                                                        </select>
                                                    </div>

                                                    {% set defaultTime = 20 %}
                                                    {% if 'redukcj' in goalName or 'rzeźb' in goalName %}{% set defaultTime = 35 %}
                                                    {% elseif 'sił' in goalName %}{% set defaultTime = 5 %}{% endif %}

                                                    <div class="md:col-span-3">
                                                        <label class="font-headline text-[10px] font-bold text-outline tracking-tighter uppercase mb-2 block">Czas (min)</label>
                                                        <select name="duration" required class="w-full bg-surface-container-highest border-none text-center text-on-surface font-headline font-black text-xl focus:ring-0 p-0 h-12">
                                                            {% for i in range(5, 60, 5) %}
                                                                <option value="{{ i }}" {% if i == defaultTime %}selected{% endif %}>{{ i }} min</option>
                                                            {% endfor %}
                                                        </select>
                                                    </div>

                                                    <div class="md:col-span-2">
                                                        <label class="font-headline text-[10px] font-bold text-outline tracking-tighter uppercase mb-2 block">Szybkość</label>
                                                        <input type="number" step="0.1" name="speed" class="w-full bg-surface-container-highest border-none text-center text-on-surface font-headline font-black text-xl focus:ring-0 p-0 h-12 m-0" placeholder="0">
                                                    </div>

                                                    <div class="md:col-span-2">
                                                        <label class="font-headline text-[10px] font-bold text-outline tracking-tighter uppercase mb-2 block">Pochył</label>
                                                        <input type="number" step="0.1" name="incline" class="w-full bg-surface-container-highest border-none text-center text-on-surface font-headline font-black text-xl focus:ring-0 p-0 h-12 m-0" placeholder="0">
                                                    </div>

                                                    <div class="md:col-span-2">
                                                        <button type="submit" class="w-full h-12 bg-surface-container-highest text-outline hover:text-primary-container hover:bg-[#1a1a1a] transition-colors font-headline font-bold text-xs uppercase tracking-widest border border-outline-variant/30 cursor-pointer">
                                                            + ZAPISZ
                                                        </button>
                                                    </div>
                                                </div>
                                            </form>

                                            {% if session.cardioSessions|length > 0 %}
                                                <div class="mt-6 pt-4 border-t border-outline-variant/20">
                                                    <h4 class="font-headline text-[10px] font-bold text-outline tracking-widest uppercase mb-3">Zapisane sesje Cardio</h4>
                                                    <div class="space-y-2">
                                                        {% for c in session.cardioSessions %}
                                                            <div class="bg-surface-container-high border-l-2 border-primary-container px-4 py-3 flex flex-col md:flex-row justify-between md:items-center gap-2">
                                                                <div class="flex items-center gap-3">
                                                                    <span class="material-symbols-outlined text-primary-container text-sm">check_circle</span>
                                                                    <span class="font-headline font-bold text-sm text-on-surface uppercase">{{ c.machine.name }}</span>
                                                                </div>
                                                                <div class="flex gap-4 font-headline text-xs font-bold text-on-surface-variant uppercase">
                                                                    <span>⏱ {{ c.durationMinutes }} min</span>
                                                                    {% if c.speed %}<span>| ⚡ Szyb: {{ c.speed }}</span>{% endif %}
                                                                    {% if c.incline %}<span>| 🏔 Pochył: {{ c.incline }}</span>{% endif %}
                                                                </div>
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </details>

                                    <!-- Nawigacja (zawsze widoczna) -->
                                    <div class="flex justify-between items-center mt-6 pt-6 border-t border-outline-variant/20">
                                        <button type="button" onclick="navigateExercise(-1)" class="prev-ex-btn text-outline hover:text-primary-container flex items-center gap-2 font-headline font-bold text-[10px] md:text-xs uppercase tracking-widest transition-colors">
                                            <span class="material-symbols-outlined text-lg">arrow_back</span> POPRZEDNIE
                                        </button>
                                        <div class="font-headline font-bold text-outline text-[10px] tracking-widest uppercase text-center px-4 current-ex-label">
                                            ĆWICZENIE -- Z --
                                        </div>
                                        <button type="button" onclick="navigateExercise(1)" class="next-ex-btn text-outline hover:text-primary-container flex items-center gap-2 font-headline font-bold text-[10px] md:text-xs uppercase tracking-widest transition-colors">
                                            NASTĘPNE <span class="material-symbols-outlined text-lg">arrow_forward</span>
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </div>
                    </section>
                {% endfor %}
            </div>

            <!-- Sidebar Section -->
            <div class="lg:col-span-4">
                {% include 'components/_tracker_sidebar.html.twig' %}

                <!-- Modal Potwierdzenia Zakończenia -->
                <div id="customConfirmModal" class="fixed inset-0 z-[100000] bg-black/80 backdrop-blur-sm hidden items-center justify-center">
                    <div class="bg-surface-container border-l-4 border-primary-container p-8 max-w-md w-full mx-4 shadow-2xl relative">
                        <div class="flex items-start gap-4 mb-6">
                            <span class="material-symbols-outlined text-primary-container text-4xl">task_alt</span>
                            <div>
                                <h3 class="font-headline font-black text-xl text-white uppercase tracking-tighter mb-2">Zakończenie Treningu</h3>
                                <p class="font-body text-on-surface-variant text-sm">Czy na pewno chcesz zakończyć sesję i zapisać zdobyty tonaż do systemu?</p>
                            </div>
                        </div>
                        <div class="flex justify-end gap-3">
                            <button type="button" onclick="closeCustomConfirm()" class="bg-[#131313] hover:bg-surface-container-highest text-white px-6 py-3 font-headline font-bold text-xs uppercase tracking-widest transition-colors border border-outline-variant/30">ANULUJ</button>
                            <button type="button" onclick="submitWorkoutForm()" class="bg-primary-container hover:bg-primary-dim text-on-primary-container px-6 py-3 font-headline font-black text-xs uppercase tracking-widest transition-colors shadow-lg">ZAKOŃCZ</button>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <!-- Sticky Bottom Bar -->
        {% include 'components/_tracker_footer.html.twig' %}
    </div>

    <!-- Sekcja skryptów JavaScript pozostaje bez zmian -->
    <input type="hidden" id="trackerFinishUrl" value="{{ path('app_tracker_finish', {'id': session.id}) }}">
    
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ encore_entry_script_tags('tracker') }}
{% endblock %}
