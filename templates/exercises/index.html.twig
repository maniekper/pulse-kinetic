{% extends 'app_layout.html.twig' %}

{% block title %}Baza Ćwiczeń | PULSE KINETIC{% endblock %}

{% block app_content %}
    <main class="kinetic-bg-container">
        <div class="kinetic-bg-gradient"></div>

        <header class="kinetic-main-header">
            <div class="kinetic-main-header-stripe"></div>
            <div>
                <h1 class="kinetic-main-header-title">BAZA <span class="text-primary-container">ĆWICZEŃ</span></h1>
                <p class="kinetic-main-header-subtitle">ZBROJOWNIA SPRZĘTOWA I FILTRACJA DOSTĘPNOŚCI</p>
            </div>
            <div class="hidden md:flex items-center gap-3">
                <span class="badge bg-[#1a1a1a] px-4 py-2 border border-white/10 font-headline font-bold text-xs tracking-widest text-[#767575]">
                    WYKLUCZONO: <strong id="bannedCounter" class="text-[#ff7351]">{{ bannedIds|length }}</strong> / {{ machines|length }}
                </span>
            </div>
        </header>

        <!-- PASEK FILTRÓW -->
        <div class="relative z-10 bg-[#111111]/95 backdrop-blur-xl border border-white/10 p-5 md:p-6 mb-8 space-y-5">
            <div class="flex flex-col lg:flex-row gap-4 justify-between items-stretch lg:items-center">
                <!-- Wyszukiwarka -->
                <div class="relative flex-1 max-w-md">
                    <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-[#767575] text-lg">search</span>
                    <input
                        type="text"
                        id="exerciseSearchInput"
                        placeholder="SZUKAJ MASZYNY LUB ĆWICZENIA..."
                        class="w-full bg-[#1a1a1a] border border-white/10 focus:border-primary-container focus:ring-0 pl-11 pr-4 py-3 font-headline text-xs text-white uppercase tracking-wider"
                    >
                </div>

                <!-- Przełącznik: Tylko wykluczone -->
                <button
                    type="button"
                    id="onlyBannedToggle"
                    data-active="0"
                    class="px-4 py-3 bg-[#1a1a1a] border border-white/10 text-[#767575] hover:text-white font-headline font-bold text-[10px] uppercase tracking-widest transition-colors cursor-pointer flex items-center justify-center gap-2 shrink-0"
                >
                    <span class="material-symbols-outlined text-base">block</span>
                    <span>TYLKO WYKLUCZONE</span>
                </button>
            </div>

            <!-- Filtry kategorii -->
            <div class="flex flex-wrap gap-2 pt-2 border-t border-white/5" id="categoryFilterBar">
                <button
                    type="button"
                    data-category="all"
                    class="cat-filter-btn px-3.5 py-2 bg-primary-container text-[#111111] border border-primary-container font-headline font-black text-[10px] uppercase tracking-widest cursor-pointer transition-colors"
                >
                    WSZYSTKIE
                </button>
                {% for category in categories %}
                    <button
                        type="button"
                        data-category="{{ category|lower }}"
                        class="cat-filter-btn px-3.5 py-2 bg-[#1a1a1a] text-[#767575] hover:text-white border border-white/10 font-headline font-bold text-[10px] uppercase tracking-widest cursor-pointer transition-colors"
                    >
                        {{ category }}
                    </button>
                {% endfor %}
            </div>
        </div>

        <!-- LISTA MASZYN -->
        <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="exercisesGrid">
            {% for machine in machines %}
                {% set isBanned = machine.id in bannedIds %}
                {% set catLower = (machine.category ?: 'pozostałe')|lower %}

                <article
                    class="exercise-card bg-[#111111]/95 border {{ isBanned ? 'border-[#ff7351]/40 opacity-75' : 'border-white/10' }} flex flex-col justify-between transition-all duration-200 relative overflow-hidden"
                    data-name="{{ machine.name|lower }}"
                    data-category="{{ catLower }}"
                    data-banned="{{ isBanned ? '1' : '0' }}"
                >
                    <div>
                        <!-- Podgląd faz ruchu (start / end) — powiększone okno bez przycinania -->
                        <div class="grid grid-cols-2 gap-1 bg-[#0a0a0a] border-b border-white/5 relative p-1">
                            <div class="relative aspect-square bg-[#141414] overflow-hidden flex items-center justify-center">
                                {% if machine.imageStart %}
                                    <img
                                        src="{{ asset('images/machines/' ~ machine.imageStart) }}"
                                        alt="{{ machine.name }} - start"
                                        class="w-full h-full object-contain"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <div class="w-full h-full bg-[#161616] flex items-center justify-center text-[#484847]">
                                        <span class="material-symbols-outlined text-4xl">fitness_center</span>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="relative aspect-square bg-[#141414] overflow-hidden flex items-center justify-center">
                                {% if machine.imageEnd %}
                                    <img
                                        src="{{ asset('images/machines/' ~ machine.imageEnd) }}"
                                        alt="{{ machine.name }} - koniec"
                                        class="w-full h-full object-contain"
                                        loading="lazy"
                                    >
                                {% else %}
                                    <div class="w-full h-full bg-[#161616] flex items-center justify-center text-[#484847]">
                                        <span class="material-symbols-outlined text-4xl">fitness_center</span>
                                    </div>
                                {% endif %}
                            </div>

                            <span class="banned-badge {{ isBanned ? '' : 'hidden' }} absolute top-3 left-3 z-10 bg-[#ff7351] text-[#111111] font-headline font-black text-[9px] px-2.5 py-1 uppercase tracking-widest shadow-lg">
                                WYKLUCZONA Z GENERATORA
                            </span>
                        </div>

                        <!-- Treść karty -->
                        <div class="p-5 space-y-3">
                            <div class="flex items-center justify-between gap-2">
                                <span class="font-label text-[10px] text-primary-container uppercase tracking-widest">
                                    {{ machine.category ?: 'Maszyna' }}
                                </span>
                                <span class="font-label text-[9px] text-[#767575] uppercase tracking-widest bg-[#1a1a1a] px-2 py-0.5 border border-white/5">
                                    {{ machine.mechanicType ?: 'standard' }}
                                </span>
                            </div>

                            <h2 class="font-headline font-bold text-base text-white uppercase tracking-wider leading-snug">
                                {{ machine.name }}
                            </h2>

                            {% if machine.primaryMuscles is defined and machine.primaryMuscles|length > 0 %}
                                <div class="flex flex-wrap gap-1.5">
                                    {% for muscle in machine.primaryMuscles %}
                                        <span class="text-[9px] font-headline font-bold uppercase tracking-wider px-2 py-0.5 bg-primary-container/10 text-primary-container border border-primary-container/20">
                                            {{ muscle.name }}
                                        </span>
                                    {% endfor %}
                                </div>
                            {% endif %}

                            {% if machine.description %}
                                <p class="font-body text-xs text-[#9e9e9e] leading-relaxed line-clamp-3">
                                    {{ machine.description }}
                                </p>
                            {% endif %}

                            {% if machine.tips %}
                                <div class="pt-2 border-t border-white/5">
                                    <p class="font-body text-[11px] text-[#767575] leading-relaxed">
                                        <strong class="text-white font-headline text-[10px] uppercase tracking-wider">Wskazówka:</strong>
                                        {{ machine.tips }}
                                    </p>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <!-- Przycisk blokowania / odblokowania -->
                    <div class="p-4 pt-0">
                        <button
                            type="button"
                            data-toggle-ban-btn
                            data-url="{{ path('app_exercises_toggle_ban', {'id': machine.id}) }}"
                            data-csrf="{{ csrf_token('toggle_ban_machine_' ~ machine.id) }}"
                            class="w-full py-3 px-4 font-headline font-black text-[10px] uppercase tracking-widest transition-colors cursor-pointer flex items-center justify-center gap-2 border {{ isBanned ? 'bg-primary-container/15 hover:bg-primary-container text-primary-container hover:text-[#111111] border-primary-container/40' : 'bg-[#1a1a1a] hover:bg-[#ff7351] text-[#adaaaa] hover:text-[#111111] border-white/10 hover:border-[#ff7351]' }}"
                        >
                            <span class="material-symbols-outlined text-base ban-icon">
                                {{ isBanned ? 'check_circle' : 'block' }}
                            </span>
                            <span class="ban-label">
                                {{ isBanned ? 'PRZYWRÓĆ DO GENERATORA' : 'WYKLUCZ MASZYNĘ' }}
                            </span>
                        </button>
                    </div>
                </article>
            {% endfor %}
        </div>

        <div id="exercisesEmptyFilter" class="hidden relative z-10 mt-8 bg-[#111111] border border-white/10 p-10 text-center">
            <span class="font-headline font-bold text-xs text-[#767575] uppercase tracking-widest">
                Brak ćwiczeń spełniających wybrane kryteria filtrowania.
            </span>
        </div>
    </main>

    {% block javascripts %}
        {{ parent() }}
        {{ encore_entry_script_tags('exercises_catalog') }}
    {% endblock %}
{% endblock %}
