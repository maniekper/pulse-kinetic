{% extends 'base.html.twig' %}

{% block title %}Baza Maszyn - Pulse Kinetic{% endblock %}

{% block body %}
<div class="container mx-auto p-4 max-w-7xl">
    <div class="mb-8">
        <h1 class="text-3xl font-bold text-gray-900">Baza Maszyn i Ćwiczeń</h1>
        <p class="text-gray-600 mt-2">
            Lista sprzętu ułożona pod Twój profil treningowy.
        </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for machine in machines %}
            <div class="bg-white border border-gray-200 rounded-xl p-5 shadow-sm hover:shadow-md transition-shadow">
                <div class="flex justify-between items-start mb-4">
                    <h2 class="text-xl font-bold text-gray-800">{{ machine.name }}</h2>
                    <span class="bg-blue-100 text-blue-800 text-xs font-semibold px-2.5 py-0.5 rounded">
                        {{ machine.category }}
                    </span>
                </div>
                
                <!-- Sekcja wizualizacji: 2 fazy ruchu -->
                <div class="flex gap-2 mb-4 bg-gray-50 rounded-lg p-2 border border-gray-100">
                    <div class="w-1/2">
                        <p class="text-[10px] uppercase tracking-wider text-center text-gray-500 mb-1 font-semibold">Pozycja startowa</p>
                        {% if machine.imageStart %}
                            <img src="{{ asset('images/machines/' ~ machine.imageStart) }}" 
                                 alt="Start - {{ machine.name }}" 
                                 class="w-full h-auto rounded object-contain bg-white">
                        {% else %}
                            <div class="w-full h-32 bg-gray-200 rounded flex items-center justify-center text-gray-400 text-sm">Brak</div>
                        {% endif %}
                    </div>
                    
                    <div class="w-1/2">
                        <p class="text-[10px] uppercase tracking-wider text-center text-gray-500 mb-1 font-semibold">Pozycja końcowa</p>
                        {% if machine.imageEnd %}
                            <img src="{{ asset('images/machines/' ~ machine.imageEnd) }}" 
                                 alt="Koniec - {{ machine.name }}" 
                                 class="w-full h-auto rounded object-contain bg-white">
                        {% else %}
                            <div class="w-full h-32 bg-gray-200 rounded flex items-center justify-center text-gray-400 text-sm">Brak</div>
                        {% endif %}
                    </div>
                </div>

                <div class="space-y-3">
                    <div>
                        <h3 class="text-sm font-semibold text-gray-900">Opis ruchu:</h3>
                        <p class="text-sm text-gray-600 leading-relaxed">{{ machine.description }}</p>
                    </div>
                    
                    {% if machine.tips %}
                    <div class="bg-amber-50 border-l-4 border-amber-400 p-3 rounded-r-md">
                        <p class="text-xs font-semibold text-amber-800 uppercase mb-1">Wskazówka</p>
                        <p class="text-sm text-amber-900">{{ machine.tips }}</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        {% else %}
            <div class="col-span-full text-center py-10 bg-gray-50 rounded-xl border border-dashed border-gray-300">
                <p class="text-gray-500">Brak maszyn w bazie danych.</p>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
