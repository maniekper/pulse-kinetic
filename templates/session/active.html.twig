{% extends 'base.html.twig' %}

{% block title %}Trening Trwa - Pulse Kinetic{% endblock %}

{% block stylesheets %}
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #121212; color: #f8f9fa; }
        .card { background-color: #1e1e1e; border: 1px solid #333; }
        .machine-title { color: #0d6efd; }
    </style>
{% endblock %}

{% block body %}
<div class="container mt-4">
    {% for message in app.flashes('success') %}
        <div class="alert alert-success fw-bold text-center border-success" role="alert">
            {{ message }}
        </div>
    {% endfor %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-success">🔴 {{ routine.name }}</h2>
        <span class="badge bg-dark text-light border">Start: {{ session.startedAt|date('H:i') }}</span>
    </div>

    {% for routineMachine in routine.routineMachines %}
        {% set machine = routineMachine.machine %}
        {% set target = targets[machine.id] %}
        {% set last = lastSets[machine.id] %}
        
        <div class="card p-3 mb-4 shadow-sm border-secondary">
            <h4 class="machine-title fw-bold mb-1">{{ machine.name }}</h4>
            
            <!-- Dynamiczne wytyczne z kalkulatora -->
            <div class="d-flex justify-content-between text-warning small fw-bold mb-3">
                <span>Cel: {{ target.repsMin }}-{{ target.repsMax }} powt.</span>
                <span>Przerwa: {{ target.restSeconds // 60 }} min {{ target.restSeconds % 60 }} sec</span>
            </div>
            
            {% if last %}
                <div class="text-muted small mb-2">
                    <i class="bi bi-clock-history"></i> Ostatnio: <strong class="text-light">{{ last.weight }} kg x {{ last.reps }}</strong>
                </div>
            {% endif %}

            <!-- Pola do wpisywania wyników z autouzupełnianiem -->
            <form action="{{ path('app_session_log_set', {'id': session.id, 'machineId': machine.id}) }}" method="POST" class="mb-2">
                <div class="d-flex gap-2 mb-2">
                    <div class="input-group input-group-sm w-50">
                        <span class="input-group-text bg-dark text-light border-secondary">Ciężar</span>
                        <input type="number" step="0.5" name="weight" 
                               class="form-control bg-dark text-light border-secondary text-center" 
                               value="{{ last ? last.weight : '' }}" required>
                        <span class="input-group-text bg-dark text-light border-secondary">kg</span>
                    </div>
                    <div class="input-group input-group-sm w-50">
                        <span class="input-group-text bg-dark text-light border-secondary">Powt.</span>
                        <input type="number" name="reps" 
                               class="form-control bg-dark text-light border-secondary text-center" 
                               value="{{ last ? last.reps : '' }}" required>
                    </div>
                </div>
                <button type="submit" class="btn btn-outline-success btn-sm w-100 fw-bold">Zapisz serię</button>
            </form>
        </div>
    {% endfor %}

    <div class="mt-5 mb-5 text-center">
<a href="{{ path('app_session_end', {'id': session.id}) }}" class="btn btn-danger btn-lg w-100 fw-bold">Zakończ Trening</a>    </div>
</div>
{% endblock %}