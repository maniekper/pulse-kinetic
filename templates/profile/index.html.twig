{% extends 'app_layout.html.twig' %}

{% block title %}Twój Profil | PULSE KINETIC{% endblock %}

{% block app_content %}
    <main class="kinetic-bg-container">
        
        <div class="kinetic-bg-gradient"></div>           
        
        <header class="kinetic-main-header">
            <div class="kinetic-main-header-stripe"></div>
            <div>
                <h1 class="kinetic-main-header-title">PROFIL <span class="text-primary-container">OPERATORA</span></h1>
                <p class="kinetic-main-header-subtitle">KONFIGURACJA PARAMETRÓW I PROTOKOŁU</p>
            </div>
            <div class="hidden md:block">
                <span class="badge bg-[#1a1a1a] px-4 py-2 border border-white/10 font-headline font-bold text-xs tracking-widest text-[#767575]">{{ app.user.email }}</span>
            </div>
        </header>

        <div class="relative z-10">
            {% for label, messages in app.flashes %}
                {% set isError = label == 'error' %}
                {% for message in messages %}
                    <div class="{{ isError ? 'bg-[#ff7351]/10 border-[#ff7351]' : 'bg-primary-container/10 border-primary-container' }} border p-4 mb-8 flex items-center gap-4">
                        <span class="material-symbols-outlined {{ isError ? 'text-[#ff7351]' : 'text-primary-container' }}">
                            {{ isError ? 'error' : 'task_alt' }}
                        </span>
                        <span class="font-headline font-bold text-[11px] {{ isError ? 'text-[#ff7351]' : 'text-primary-container' }} uppercase tracking-widest">{{ message }}</span>
                    </div>
                {% endfor %}
            {% endfor %}
        </div>

        <form action="{{ path('app_profile') }}" method="POST" class="grid grid-cols-1 xl:grid-cols-3 gap-8 relative z-10">
            
            <!-- Lewa Kolumna (2 sekcje) -->
            <div class="xl:col-span-2 space-y-8">
                <div class="bg-[#111111]/95 backdrop-blur-xl p-8 border-l border-t border-white/5 shadow-2xl relative">
                    <div class="absolute top-0 right-0 w-12 h-12 bg-[#1a1a1a] flex items-center justify-center border-b border-l border-white/5">
                        <span class="material-symbols-outlined text-[#767575]">monitor_weight</span>
                    </div>
                    <h2 class="font-headline font-black text-sm text-white uppercase tracking-widest mb-8">BIOMETRIA & PARAMETRY</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="space-y-2 group">
                            <label class="text-[9px] font-bold text-[#767575] uppercase tracking-widest group-focus-within:text-primary-container transition-colors font-headline block">WIEK (LATA)</label>
                            <input type="number" name="age" value="{{ app.user.age }}" class="w-full bg-[#1a1a1a] border-0 border-b-2 border-white/10 px-4 py-3.5 font-headline text-lg text-white focus:outline-none focus:border-primary-container font-black tracking-tighter">
                        </div>
                        <div class="space-y-2 group">
                            <label class="text-[9px] font-bold text-[#767575] uppercase tracking-widest group-focus-within:text-primary-container transition-colors font-headline block">WAGA (KG)</label>
                            <input type="number" step="0.1" name="weight" value="{{ app.user.weight }}" class="w-full bg-[#1a1a1a] border-0 border-b-2 border-white/10 px-4 py-3.5 font-headline text-lg text-white focus:outline-none focus:border-primary-container font-black tracking-tighter text-primary-container">
                        </div>
                        <div class="space-y-2 group">
                            <label class="text-[9px] font-bold text-[#767575] uppercase tracking-widest group-focus-within:text-primary-container transition-colors font-headline block">WZROST (CM)</label>
                            <input type="number" step="1" name="height" value="{{ app.user.height }}" class="w-full bg-[#1a1a1a] border-0 border-b-2 border-white/10 px-4 py-3.5 font-headline text-lg text-white focus:outline-none focus:border-primary-container font-black tracking-tighter">
                        </div>
                    </div>

                    {% if app.user.weight and app.user.height %}
                        {% set heightMeter = app.user.height / 100 %}
                        {% set bmi = app.user.weight / (heightMeter * heightMeter) %}
                        <div class="mt-8 border-t border-white/5 pt-6 flex items-center justify-between">
                            <span class="font-headline font-bold text-[9px] text-[#767575] uppercase tracking-widest">AKTUALNY WSPÓŁCZYNNIK MASY (BMI)</span>
                            <span class="font-headline font-black text-2xl text-white">{{ bmi|number_format(1, '.', '') }}</span>
                        </div>
                    {% endif %}
                </div>

                <div class="bg-[#111111]/95 backdrop-blur-xl p-8 border-l border-t border-white/5 shadow-2xl relative">
                    <div class="absolute top-0 right-0 w-12 h-12 bg-[#1a1a1a] flex items-center justify-center border-b border-l border-white/5">
                        <span class="material-symbols-outlined text-[#767575]">badge</span>
                    </div>
                    <h2 class="font-headline font-black text-sm text-white uppercase tracking-widest mb-8">DANE IDENTYFIKACYJNE</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="space-y-2 group">
                            <label class="text-[9px] font-bold text-[#767575] uppercase tracking-widest group-focus-within:text-primary-container transition-colors font-headline block">IMIĘ / PSEUDONIM</label>
                            <input type="text" name="name" value="{{ app.user.name }}" required class="w-full bg-[#1a1a1a] border-0 border-b-2 border-white/10 px-4 py-3.5 font-headline text-sm text-white focus:outline-none focus:border-primary-container font-bold">
                        </div>
                        
                    </div>
                </div>
            </div>

            <!-- Prawa Kolumna (Cel Treningowy i Zapis) -->
            <div class="space-y-8">
                <div class="bg-[#111111]/95 backdrop-blur-xl p-8 border-l border-t border-white/5 shadow-2xl relative h-full flex flex-col">
                    <div class="absolute top-0 right-0 w-12 h-12 bg-[#1a1a1a] flex items-center justify-center border-b border-l border-white/5">
                        <span class="material-symbols-outlined text-[#767575]">track_changes</span>
                    </div>
                    <h2 class="font-headline font-black text-sm text-white uppercase tracking-widest mb-4">DYREKTYWA SYSTEMU</h2>
                    <p class="font-body text-[#767575] text-[11px] leading-relaxed mb-8">
                        Wybór celu zmienia działanie generatora parametrów (przerwy, objętość, zakresy powtórzeń).
                    </p>
                    
                    <div class="space-y-2 group mb-auto">
                        <label class="text-[9px] font-bold text-[#767575] uppercase tracking-widest group-focus-within:text-primary-container transition-colors font-headline block">GŁÓWNY CEL OPERACYJNY</label>
                        
                        <!-- CUSTOMOWY DROPDOWN: CEL OPERACYJNY -->
                        <div class="relative" id="goalSelectContainer">
                            <input type="hidden" name="goal_id" id="goalInput" value="{{ app.user.currentGoal ? app.user.currentGoal.id : (goals|first).id|default('') }}">
                            
                            <button type="button" onclick="toggleDropdown('goalDropdown', 'goalArrow')" class="w-full bg-[#1a1a1a] border-0 border-b-2 border-white/10 px-4 py-4 font-headline text-sm text-primary-container focus:outline-none focus:border-primary-container cursor-pointer font-black uppercase tracking-widest flex justify-between items-center text-left relative z-20">
                                <span id="goalSelectedText">{{ app.user.currentGoal ? app.user.currentGoal.name : 'WYBIERZ CEL' }}</span>
                                <span class="material-symbols-outlined text-[#767575] transition-transform duration-200 pointer-events-none" id="goalArrow">expand_more</span>
                            </button>

                            <div id="goalDropdown" class="hidden absolute top-full left-0 w-full mt-1 bg-[#1a1a1a] border border-white/10 shadow-[0_10px_30px_rgba(0,0,0,0.8)] z-50 flex-col">
                                {% for goal in goals %}
                                    <div onclick="selectOption('goalInput', '{{ goal.id }}', 'goalSelectedText', '{{ goal.name }}', 'goalDropdown', 'goalArrow')" class="px-4 py-4 font-headline text-sm font-black text-white uppercase tracking-widest cursor-pointer hover:bg-primary-container hover:text-on-primary-container transition-colors border-l-4 border-transparent hover:border-primary-container">
                                        {{ goal.name }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <button type="submit" class="mt-12 w-full bg-primary-container hover:bg-primary-dim py-5 px-6 flex items-center justify-between group transition-all duration-300 active:scale-[0.98]">
                        <span class="font-headline font-black text-sm text-[#111111] uppercase tracking-widest">AKTUALIZUJ PARAMETRY</span>
                        <span class="material-symbols-outlined text-[#111111] font-black transition-transform duration-300 group-hover:translate-x-1.5">save</span>
                    </button>
                </div>
            </div>
        </form>

        <!-- SEKCJA: WYKLUCZONY SPRZĘT -->
        <div class="relative z-10 mt-8">
            <div class="bg-[#111111]/95 backdrop-blur-xl p-8 border-l border-t border-white/5 shadow-2xl relative flex flex-col">
                <div class="absolute top-0 right-0 w-12 h-12 bg-[#1a1a1a] flex items-center justify-center border-b border-l border-white/5">
                    <span class="material-symbols-outlined text-[#767575]">block</span>
                </div>
                <h2 class="font-headline font-black text-sm text-white uppercase tracking-widest mb-4">WYKLUCZONY SPRZĘT</h2>
                <p class="font-body text-[#767575] text-[11px] leading-relaxed mb-6">
                    Poniższe maszyny zostały zablokowane operacyjnie i nie będą przydzielane przez generator podczas budowy nowych planów.
                </p>

                <div class="space-y-3">
                    {% if bannedMachines is defined and bannedMachines|length > 0 %}
                        {% for machine in bannedMachines %}
                            <div class="flex items-center justify-between bg-[#1a1a1a] border border-white/5 p-4 group hover:border-primary-container transition-colors">
                                <div class="flex flex-col">
                                    <span class="font-label text-[9px] text-[#767575] uppercase tracking-widest">{{ machine.mechanicType|default('Maszyna') }}</span>
                                    <span class="font-headline font-bold text-sm text-white uppercase tracking-widest">{{ machine.name }}</span>
                                </div>
                                <form action="{{ path('app_profile_unban', {'id': machine.id}) }}" method="POST">
                                    <button type="submit" class="text-[#767575] hover:text-primary-container transition-colors p-2 cursor-pointer" title="Przywróć do generatora">
                                        <span class="material-symbols-outlined">settings_backup_restore</span>
                                    </button>
                                </form>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="text-center p-6 border border-white/5 border-dashed">
                            <span class="font-label text-[10px] text-[#767575] uppercase tracking-widest">Brak wykluczeń. Algorytm ma pełen dostęp do zbrojowni.</span>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
        <!-- SEKCJA: ZMIANA HASŁA -->
        <div class="relative z-10 mt-8">
            <div class="bg-[#111111]/95 backdrop-blur-xl p-8 border-l border-t border-white/5 shadow-2xl relative">
                <div class="absolute top-0 right-0 w-12 h-12 bg-[#1a1a1a] flex items-center justify-center border-b border-l border-white/5">
                    <span class="material-symbols-outlined text-[#767575]">lock_reset</span>
                </div>
                <h2 class="font-headline font-black text-sm text-white uppercase tracking-widest mb-2">BEZPIECZEŃSTWO & ZMIANA HASŁA</h2>
                <p class="font-body text-[#767575] text-[11px] leading-relaxed mb-8">
                    Zaktualizuj hasło dostępowe do konta. Wymagane jest minimum 8 znaków.
                </p>

                <form action="{{ path('app_profile_change_password') }}" method="POST" class="space-y-6">
                    <input type="hidden" name="_token" value="{{ csrf_token('change_password_' ~ app.user.id) }}">

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div class="space-y-2 group">
                            <label for="current_password" class="text-[9px] font-bold text-[#767575] uppercase tracking-widest group-focus-within:text-primary-container transition-colors font-headline block">OBECNE HASŁO</label>
                            <input type="password" id="current_password" name="current_password" required autocomplete="current-password" class="w-full bg-[#1a1a1a] border-0 border-b-2 border-white/10 px-4 py-3.5 font-headline text-sm text-white focus:outline-none focus:border-primary-container font-bold">
                        </div>

                        <div class="space-y-2 group">
                            <label for="new_password" class="text-[9px] font-bold text-[#767575] uppercase tracking-widest group-focus-within:text-primary-container transition-colors font-headline block">NOWE HASŁO</label>
                            <input type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password" class="w-full bg-[#1a1a1a] border-0 border-b-2 border-white/10 px-4 py-3.5 font-headline text-sm text-white focus:outline-none focus:border-primary-container font-bold">
                        </div>

                        <div class="space-y-2 group">
                            <label for="confirm_new_password" class="text-[9px] font-bold text-[#767575] uppercase tracking-widest group-focus-within:text-primary-container transition-colors font-headline block">POWTÓRZ NOWE HASŁO</label>
                            <input type="password" id="confirm_new_password" name="confirm_new_password" required minlength="8" autocomplete="new-password" class="w-full bg-[#1a1a1a] border-0 border-b-2 border-white/10 px-4 py-3.5 font-headline text-sm text-white focus:outline-none focus:border-primary-container font-bold">
                        </div>
                    </div>

                    <div class="flex justify-end pt-2">
                        <button type="submit" class="px-8 py-4 bg-[#1a1a1a] hover:bg-primary-container text-white hover:text-[#111111] border border-white/10 hover:border-primary-container font-headline font-black text-xs uppercase tracking-widest transition-all duration-300 flex items-center gap-3 cursor-pointer">
                            <span>ZMIEŃ HASŁO</span>
                            <span class="material-symbols-outlined text-base">key</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
        <!-- STREFA NIEBEZPIECZNA -->
        <div class="relative z-10 mt-12 bg-[#111111] border border-[#ff7351]/30 p-6 md:p-8 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">            <div>
                <h3 class="font-headline font-black text-sm text-[#ff7351] uppercase tracking-widest mb-1">
                    STREFA NIEBEZPIECZNA
                </h3>
                <p class="font-body text-xs text-[#767575]">
                    Usunięcie konta jest nieodwracalne. Stracisz wszystkie plany, historię treningów i rekordy.
                </p>
            </div>

            <button
                type="button"
                id="openDeleteAccountModal"
                class="px-6 py-3 bg-[#ff7351]/10 border border-[#ff7351]/40 text-[#ff7351] hover:bg-[#ff7351] hover:text-[#111111] font-headline font-black text-[10px] uppercase tracking-widest transition-colors cursor-pointer shrink-0 flex items-center gap-2"
            >
                <span class="material-symbols-outlined text-base">delete_forever</span>
                USUŃ KONTO
            </button>
        </div>

        <!-- MODAL POTWIERDZENIA USUNIĘCIA KONTA -->
        <div id="deleteAccountModal" class="fixed inset-0 z-[100000] bg-black/85 backdrop-blur-sm hidden items-center justify-center p-4">
            <div class="bg-[#111111] border border-[#ff7351]/40 max-w-md w-full p-6 md:p-8 shadow-2xl">
                <div class="flex items-center gap-3 mb-4 text-[#ff7351]">
                    <span class="material-symbols-outlined text-2xl">warning</span>
                    <h4 class="font-headline font-black text-base uppercase tracking-widest">POTWIERDŹ USUNIĘCIE</h4>
                </div>

                <p class="font-body text-xs text-[#adaaaa] leading-relaxed mb-6">
                    Tej operacji nie można cofnąć. Aby potwierdzić trwałe usunięcie konta <strong class="text-white">{{ app.user.email }}</strong>, wpisz swoje aktualne hasło:
                </p>

                <form method="post" action="{{ path('app_profile_delete') }}" class="space-y-5">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete_account_' ~ app.user.id) }}">

                    <div>
                        <label for="confirm_password" class="font-headline font-bold text-[10px] text-[#767575] uppercase tracking-widest block mb-2">
                            AKTUALNE HASŁO
                        </label>
                        <input
                            type="password"
                            id="confirm_password"
                            name="confirm_password"
                            required
                            autocomplete="current-password"
                            class="w-full bg-[#1a1a1a] border border-white/10 focus:border-[#ff7351] focus:ring-0 px-4 py-3 font-headline text-sm text-white"
                        >
                    </div>

                    <div class="flex justify-end gap-3 pt-2">
                        <button
                            type="button"
                            id="closeDeleteAccountModal"
                            class="px-5 py-2.5 border border-white/10 text-[#767575] hover:text-white font-headline font-bold text-[10px] uppercase tracking-widest transition-colors cursor-pointer"
                        >
                            ANULUJ
                        </button>
                        <button
                            type="submit"
                            class="px-5 py-2.5 bg-[#ff7351] hover:bg-[#ff8a6d] text-[#111111] font-headline font-black text-[10px] uppercase tracking-widest transition-colors cursor-pointer"
                        >
                            USUŃ TRWALE
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </main>

    <!-- Skrypt do obsługi dropdownów -->
    {% block javascripts %}
        {{ parent() }}
        {{ encore_entry_script_tags('profile') }}
    {% endblock %}
{% endblock %}
