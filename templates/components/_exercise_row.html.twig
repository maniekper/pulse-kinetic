<div class="bg-[#111111] border border-white/10 border-l-4 border-l-primary-container/60 p-5 md:p-6 shadow-lg relative group hover:border-primary-container/50 transition-colors flex flex-col gap-5">

    <!-- GÓRA: Numer + nazwa + mięsień po lewej, typ ruchu po prawej -->
    <div class="flex items-start justify-between gap-4">
        <div class="flex flex-col gap-2 min-w-0">
            <div class="flex items-baseline gap-3">
                <span class="font-headline font-black text-3xl md:text-4xl text-primary-container leading-none tracking-tight shrink-0">
                    {{ index > 9 ? index : '0' ~ index }}
                </span>
                <h3 class="font-headline font-black text-base md:text-xl text-white uppercase tracking-tight leading-snug">
                    {{ exercise.machine.name }}
                </h3>
            </div>

            {% if exercise.machine.primaryMuscles|length > 0 %}
                <div class="flex flex-wrap gap-1.5 pl-0 sm:pl-12">
                    {% for m in exercise.machine.primaryMuscles %}
                        <span class="font-label text-[9px] font-bold text-primary-container bg-primary-container/10 px-2.5 py-1 uppercase tracking-widest border border-primary-container/30">
                            {{ m.name }}
                        </span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <span class="font-label text-[9px] text-[#767575] uppercase tracking-[0.2em] text-right shrink-0 pt-1">
            {{ exercise.machine.mechanicType == 'compound' ? 'BÓJ WIELOSTAWOWY' : 'IZOLACJA' }}
        </span>
    </div>

    <!-- ŚRODEK: Grafika maszyny (2 fazy obok siebie) -->
    <div class="w-full bg-[#181818] border border-white/10 overflow-hidden relative shadow-inner p-2.5 sm:p-3">
        {% if exercise.machine.imageStart and exercise.machine.imageEnd %}
            <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
                <div class="relative h-44 sm:h-52 bg-[#121212] border border-white/10 overflow-hidden flex items-center justify-center p-1.5">
                    <span class="absolute top-2 left-2 bg-black/90 px-2 py-0.5 font-headline font-black text-[9px] text-white tracking-widest uppercase z-10 border border-white/20">
                        F1
                    </span>
                    <img
                        src="{{ asset('images/machines/' ~ exercise.machine.imageStart) }}"
                        alt="{{ exercise.machine.name }} - Faza 1"
                        class="w-full h-full object-contain mix-blend-luminosity opacity-90 group-hover:opacity-100 transition-opacity"
                    >
                </div>
                <div class="relative h-44 sm:h-52 bg-[#121212] border border-white/10 overflow-hidden flex items-center justify-center p-1.5">
                    <span class="absolute top-2 left-2 bg-black/90 px-2 py-0.5 font-headline font-black text-[9px] text-white tracking-widest uppercase z-10 border border-white/20">
                        F2
                    </span>
                    <img
                        src="{{ asset('images/machines/' ~ exercise.machine.imageEnd) }}"
                        alt="{{ exercise.machine.name }} - Faza 2"
                        class="w-full h-full object-contain mix-blend-luminosity opacity-90 group-hover:opacity-100 transition-opacity"
                    >
                </div>
            </div>
        {% elseif exercise.machine.imageStart %}
            <div class="w-full h-44 sm:h-52 bg-[#121212] border border-white/10 overflow-hidden relative flex items-center justify-center p-1.5">
                <img
                    src="{{ asset('images/machines/' ~ exercise.machine.imageStart) }}"
                    alt="{{ exercise.machine.name }}"
                    class="w-full h-full object-contain mix-blend-luminosity opacity-90 group-hover:opacity-100 transition-opacity"
                >
            </div>
        {% else %}
            <div class="w-full h-44 sm:h-52 flex items-center justify-center">
                <span class="material-symbols-outlined text-outline text-5xl">fitness_center</span>
            </div>
        {% endif %}
    </div>

    <!-- DÓŁ: Na mobile 2 rzędy (metryki nad przyciskiem), od sm w górę jedna równa linia -->
    <div class="grid grid-cols-12 gap-2.5 sm:gap-3 items-stretch">
        <!-- POWTÓRZEŃ -->
        <div class="col-span-7 sm:col-span-5 min-h-[3.5rem] sm:min-h-[4.25rem] bg-[#171717] border border-primary-container/35 px-3.5 sm:px-4 py-3 flex items-center justify-between gap-2 min-w-0">
            <span class="font-label text-[9px] md:text-[10px] font-bold text-primary-container/80 uppercase tracking-[0.12em]">
                POWTÓRZEŃ
            </span>
            <span class="font-headline font-black text-2xl md:text-3xl text-primary-container leading-none tracking-tight whitespace-nowrap shrink-0">
                {{ exercise.reps }}
            </span>
        </div>

        <!-- SERIE -->
        <div class="col-span-5 sm:col-span-4 min-h-[3.5rem] sm:min-h-[4.25rem] bg-[#171717] border border-white/15 px-3.5 sm:px-4 py-3 flex items-center justify-between gap-2 min-w-0">
            <span class="font-label text-[9px] md:text-[10px] font-bold text-[#9a9a9a] uppercase tracking-[0.12em]">
                SERIE
            </span>
            <span class="font-headline font-black text-2xl md:text-3xl text-white leading-none tracking-tight whitespace-nowrap shrink-0">
                {{ exercise.sets }}
            </span>
        </div>

        <!-- WYMIANA -->
        <div class="col-span-12 sm:col-span-3 min-h-[3rem] sm:min-h-[4.25rem] flex items-stretch min-w-0">
            <button
                type="button"
                onclick="window.openSwapModal({{ exercise.id }}, '{{ exercise.machine.name|escape('js') }}', '{% if exercise.machine.primaryMuscles|length > 0 %}{{ exercise.machine.primaryMuscles.first.name|escape('js') }}{% endif %}', {{ used_machine_ids|default('[]')|json_encode }})"
                class="w-full h-full bg-[#1a1a1a] border border-white/15 text-[#b5b5b5] hover:text-[#111111] hover:bg-primary-container hover:border-primary-container transition-colors flex items-center justify-center gap-1.5 px-3 py-2.5 sm:py-2 cursor-pointer shadow font-headline font-bold text-[10px] sm:text-xs uppercase tracking-wider whitespace-nowrap"
                title="Wymień sprzęt"
            >
                <span class="material-symbols-outlined text-base sm:text-lg leading-none shrink-0">published_with_changes</span>
                <span>WYMIANA</span>
            </button>
        </div>
    </div>

</div>
