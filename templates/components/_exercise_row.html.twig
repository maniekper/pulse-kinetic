<div class="bg-[#111111] border border-white/10 p-5 md:p-6 flex flex-col shadow-lg relative group hover:border-primary-container/40 transition-colors">
    <div class="flex flex-row w-full gap-6">
        
        <!-- LEWA POŁOWA (50%): Numer na górze, kwadratowa grafika pod spodem -->
        <div class="w-1/2 flex flex-col">
            <div class="font-headline font-black text-3xl md:text-4xl text-primary-container leading-none mb-3">
                {{ index > 9 ? index : '0' ~ index }}
            </div>
            <!-- Duża, kwadratowa miniatura -->
            <div class="w-full aspect-square bg-[#1a1a1a] border border-white/10 overflow-hidden relative flex items-center justify-center shadow-md p-2">
                {% if exercise.machine.imageStart %}
                    <img src="{{ asset('images/machines/' ~ exercise.machine.imageStart) }}" class="w-full h-full object-contain mix-blend-luminosity opacity-90">
                {% else %}
                    <span class="material-symbols-outlined text-outline text-4xl">fitness_center</span>
                {% endif %}
            </div>
        </div>

        <!-- PRAWA POŁOWA (50%): Zrównana z obrazkiem (pt-11) -->
        <div class="w-1/2 flex flex-col justify-between pt-10 md:pt-11">
            
            <!-- GÓRA: Nazwa maszyny i partie mięśniowe -->
            <div>
                <h3 class="font-headline font-black text-base md:text-xl text-white uppercase tracking-tight leading-snug mb-2">
                    {{ exercise.machine.name }}
                </h3>
                {% if exercise.machine.primaryMuscles|length > 0 %}
                    <div class="flex flex-wrap gap-1.5">
                        {% for m in exercise.machine.primaryMuscles %}
                            <span class="font-label text-[9px] text-primary-container bg-primary-container/10 px-2 py-1 uppercase tracking-widest border border-primary-container/20">
                                {{ m.name }}
                            </span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            <!-- DÓŁ: Serie, powtórzenia (JEDNO POD DRUGIM) i Przyciski -->
            <div class="flex flex-col gap-3 mt-4">
                <!-- Statystyki w układzie pionowym -->
                <div class="flex flex-col gap-2">
                    <div class="bg-[#161616] border border-white/5 p-2 md:p-3 text-center flex flex-col justify-center">
                        <span class="font-headline font-black text-xl md:text-2xl text-white leading-none">{{ exercise.sets }}</span>
                        <span class="font-label text-[9px] text-[#767575] uppercase tracking-widest mt-1">SERIE</span>
                    </div>
                    
                    <div class="bg-[#161616] border border-white/5 p-2 md:p-3 text-center flex flex-col justify-center">
                        <span class="font-headline font-black text-xl md:text-2xl text-primary-container leading-none">{{ exercise.reps }}</span>
                        <span class="font-label text-[9px] text-[#767575] uppercase tracking-widest mt-1">POWTÓRZEŃ</span>
                    </div>
                </div>

                <!-- Przyciski akcji -->
                <div class="flex justify-end gap-2 mt-1">
                    <button type="button" onclick="openSwapModal({{ exercise.id }}, '{{ exercise.machine.name|escape('js') }}', '{% if exercise.machine.primaryMuscles|length > 0 %}{{ exercise.machine.primaryMuscles.first.name|escape('js') }}{% endif %}')" class="w-12 h-12 bg-[#1a1a1a] border border-white/10 text-[#767575] hover:text-primary-container hover:border-primary-container/50 transition-colors flex items-center justify-center cursor-pointer shadow" title="Wymień sprzęt">
                        <span class="material-symbols-outlined text-lg">published_with_changes</span>
                    </button>
                    <div class="w-12 h-12 bg-[#1a1a1a] border border-white/10 flex items-center justify-center text-[#767575] shadow">
                        <span class="material-symbols-outlined text-lg">check</span>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>
