<style>
    /* Domyślny kolor całego ciała (zmieniamy z czarnego/bardzo ciemnego na czytelny szary) */
    .muscle-group {
        fill: #444444 !important; /* Jaśniejszy szary kolor sylwetki */
        stroke: #222222 !important;
        stroke-width: 1px;
        transition: fill 0.3s ease;
    }

    /* Aktywny główny mięsień (neonowy akcent) */
    .muscle-active-primary {
        fill: var(--theme-main) !important;
        stroke: var(--theme-main) !important;
        filter: drop-shadow(0 0 8px var(--theme-shadow));
    }

    /* Aktywny pomocniczy mięsień */
    .muscle-active-secondary {
        fill: var(--theme-shadow) !important;
        stroke: var(--theme-main) !important;
    }
    #layer-base path {
        fill: #2d2d30;
        stroke: #3f3f46;
        stroke-width: 2px;
    }
</style>
